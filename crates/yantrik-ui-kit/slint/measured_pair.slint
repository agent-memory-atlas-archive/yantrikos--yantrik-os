// MeasuredPair — a label and its value, as a reading is written: `Humidity 48%`.
//
// Six of these in a fixed grid replaced Weather's six bordered tiles (design/weather-redesign-
// 2026-10-21.md §3.2): a measurement is typography, not a card. The label is secondary, the
// value primary and semibold; neither wraps, and a value too long for its column elides rather
// than pushing the grid. System Monitor and Network take the same pair next, so the widths are
// the caller's (a grid column), not this component's.
import { Theme } from "theme.slint";

export component MeasuredPair inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    // The grid's column: every pair in a column takes it, so the values start at one x across
    // rows. The label keeps a fixed share; a value too long for the rest elides, the label never.
    in property <length> column-width: 160px;
    in property <length> label-width: 76px;
    width: root.column-width;
    spacing: Theme.sp-2;
    alignment: start;

    Text {
        text: root.label;
        width: root.label-width;
        color: Theme.text-secondary;
        font-size: Theme.fs-body;
        font-weight: Theme.fw-body;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        text: root.value;
        horizontal-stretch: 1;
        color: Theme.text-primary;
        font-size: Theme.fs-body;
        font-weight: Theme.fw-title-2;
        vertical-alignment: center;
        overflow: elide;
    }
}
