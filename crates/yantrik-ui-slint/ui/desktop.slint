// Desktop screen — the AI-native desktop experience.
// Clean canvas: particle field + greeting + bottom-center orb.
// Intent Lens overlays when invoked.
// No clutter. The AI is alive, not widgetized.
//
// Layout:
//   ┌─────────────────────────────────────┐
//   │ StatusBar (24px) [●] 14:32    87%  │
//   ├─────────────────────────────────────┤
//   │                                     │
//   │    ░░░ particle field ░░░           │
//   │                                     │
//   │       Good evening, Pranab          │
//   │          12 memories                │
//   │                                     │
//   │              ◉ orb                  │
//   │                                     │
//   │▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁│ ← dock glow trigger
//   └─────────────────────────────────────┘
//
//   Intent Lens: overlays center-screen when Super pressed

import { Theme, ThemeMode } from "theme.slint";
import { ParticleField } from "components/particle_field.slint";
import { Orb } from "components/orb.slint";
import { StatusBar } from "components/status_bar.slint";
import { AppDock, DockItem } from "components/app_dock.slint";
import { Taskbar } from "components/taskbar.slint";
import { Icon, Icons } from "components/icon.slint";
import { IntentLens, LensResult } from "components/intent_lens.slint";
import { MessageData } from "components/message_bubble.slint";
import { UrgeCardData, GlanceCard } from "components/glance_card.slint";
import { WhisperCardStack, WhisperCardItem } from "components/whisper_card.slint";
import { QuickSettings } from "components/quick_settings.slint";
import { ClipboardPanel, ClipboardEntryData } from "components/clipboard_panel.slint";
import { PowerMenu } from "components/power_menu.slint";
import { AppGrid, AppGridItem, CategoryItem } from "components/app_grid.slint";
import { MachineRail, ServiceItem } from "components/machine_rail.slint";
import { WindowSwitcher, WindowItem } from "components/window_switcher.slint";
import { CommandPalette, CommandItem } from "components/command_palette.slint";
import { MorningBriefCard, BriefSection } from "components/morning_brief.slint";
import { Tr } from "translations.slint";

import { YContextMenu, YMenuAction } from "components/y_context_menu.slint";

export component DesktopScreen inherits Rectangle {
    // Status bar state
    in property <string> clock-text: "00:00";
    in property <string> companion-status: "idle";
    in property <bool> companion-online: true;
    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <bool> battery-charging: false;
    in property <bool> wifi-connected: false;
    in property <int> pending-count: 0;
    in property <bool> settings-incognito-mode: false;
    in property <bool> dnd-mode: false;
    // Panel readouts — load from the observer poll, date from the clock timer
    in property <int> bar-cpu-percent: 0;
    in property <string> bar-mem-text: "";
    in property <string> date-text: "";
    in property <int> bar-mem-percent: 0;
    in property <int> bar-swap-percent: 0;
    in property <string> bar-swap-text: "";
    in property <int> bar-disk-percent: 0;
    in property <string> bar-disk-text: "";
    in property <[ServiceItem]> services: [];
    in property <string> bond-level: "Stranger";
    in property <float> bond-score: 0.0;
    // Launcher categories
    in property <[CategoryItem]> grid-categories: [];
    in property <string> grid-active-category: "all";
    callback grid-category-selected(string);

    // Companion state
    in property <bool> is-thinking: false;
    in property <bool> has-urges: false;
    in property <bool> is-speaking: false;
    in property <bool> is-listening: false;
    in property <string> greeting-text: "Hello";
    in property <int> memory-count: 0;

    // Ambient Intelligence
    // Ambient animation budget, in milliseconds per tick, set from Rust at startup.
    // 16 = 60fps on a GPU; ~100 = 10fps on the software rasteriser, which costs roughly
    // a sixth as much and still moves; 0 turns ambient animation off entirely for a
    // headless or unattended deployment. Phase increments are multiplied by tick-scale
    // so the animation runs at the same SPEED at any of these rates, just fewer frames.
    in property <int> ambient-interval-ms: 16;
    // Frames are fewer at a longer interval, so each step must be proportionally larger
    // for the animation to keep the same wall-clock speed.
    property <float> tick-scale: max(16, ambient-interval-ms) / 16.0;
    in property <float> particle-sentiment: 0.0;
    in property <float> particle-cognitive-load: 0.0;
    in property <float> particle-time-of-day: 0.5;

    // Project Consciousness
    in property <string> active-project: "";

    // Intent Lens state
    in-out property <bool> lens-open: false;
    in property <[LensResult]> lens-results: [];
    in property <bool> lens-chat-mode: false;
    in property <[LensResult]> lens-suggestions: [];
    in property <[LensResult]> lens-recents: [];

    // Chat state (for lens chat mode)
    in property <[MessageData]> messages: [];
    in property <bool> is-generating: false;

    // Urges (for quiet queue)
    in property <[UrgeCardData]> urges: [];

    // Whisper Cards (floating notifications)
    in property <[WhisperCardItem]> whisper-cards: [];
    in property <int> whisper-hint-count: 0;
    callback whisper-card-dismissed(string);
    callback whisper-card-action(string);
    callback whisper-hint-clicked();

    // Morning Brief card
    in property <bool> morning-brief-visible: false;
    in property <string> morning-brief-greeting: "Good morning!";
    in property <[BriefSection]> morning-brief-sections: [];
    callback morning-brief-dismissed();
    callback morning-brief-section-action(string);

    // Quick Settings overlay
    in-out property <bool> quick-settings-open: false;
    in-out property <int> brightness-level: 80;
    in-out property <int> volume-level: 50;
    callback toggle-wifi();
    callback brightness-changed(int);
    callback volume-changed(int);

    // Clipboard panel
    in-out property <bool> clip-panel-open: false;
    in property <[ClipboardEntryData]> clip-panel-entries: [];
    in-out property <string> clip-search-query: "";
    callback clipboard-paste(int);
    callback clipboard-search(string);

    // Power menu
    in-out property <bool> power-menu-open: false;
    callback power-action(string);

    // App grid
    in-out property <bool> app-grid-open: false;
    in property <[AppGridItem]> grid-apps: [];
    callback grid-launch-app(string);
    callback grid-search-apps(string);

    // Window switcher
    in-out property <bool> window-switcher-open: false;
    in property <[WindowItem]> window-list: [];
    callback switch-window(string);

    // Command Palette (Ctrl+Shift+P)
    in-out property <bool> command-palette-open: false;
    in property <[CommandItem]> command-palette-filtered: [];
    callback command-palette-search(string);
    callback command-palette-selected(string);

    // Dock items (settable from Rust for running indicators)
    in property <[DockItem]> dock-items: [];

    // Focus mode (Workspace Morph)
    in-out property <bool> focus-mode: false;
    in property <string> focus-remaining: "";
    callback end-focus-mode();

    // Wallpaper
    // Agent mode shows the machine: both rails and the ask bar. A human gets a
    // desktop instead. Off by default — the person is the default user.
    in property <bool> agent-mode: false;

    in property <string> wallpaper-path: "";
    in property <image> wallpaper-image;

    // V61 — AI privacy indicator state
    in property <string> ai-privacy-mode: "local";
    in property <string> ai-provider-label: "";
    in property <string> ai-fallback-banner: "";
    callback ai-privacy-clicked();

    in property <string> active-harness-id: "";
    in property <string> active-harness-name: "";
    callback active-mind-clicked();

    // Callbacks
    callback send-message(string);
    callback mic-pressed();
    callback launch-app(string);

    // The desktop's right-click menu.
    //
    // Every entry dispatches through `launch-app`, the same callback the desktop icons and the
    // dock already use, so the menu cannot drift away from what clicking an icon does and needs
    // no wiring of its own on the Rust side.
    property <bool> desktop-menu-open: false;
    property <length> desktop-menu-x: 0;
    property <length> desktop-menu-y: 0;
    callback navigate-to(int);
    callback lens-query(string);
    callback lens-submit(string);
    callback lens-result-selected(string);
    callback open-lens();
    callback close-lens();

    background: Theme.bg-deep;
    clip: true;

    // ── Layer 1: Status bar (always on top, dims in focus mode) ──
    StatusBar {
        x: 0; y: 0;
        width: 100%;
        opacity: root.focus-mode ? 0.5 : 1.0;
        animate opacity { duration: 300ms; }
        clock-text: root.clock-text;
        companion-status: root.companion-status;
        companion-online: root.companion-online;
        battery-available: root.battery-available;
        battery-level: root.battery-level;
        battery-charging: root.battery-charging;
        wifi-connected: root.wifi-connected;
        pending-count: root.pending-count;
        whisper-hint-count: root.whisper-hint-count;
        incognito-enabled: root.settings-incognito-mode;
        dnd-enabled: root.dnd-mode;
        active-project: root.active-project;
        ai-privacy-mode: root.ai-privacy-mode;
        ai-provider-label: root.ai-provider-label;
        ai-fallback-banner: root.ai-fallback-banner;
        cpu-percent: root.bar-cpu-percent;
        mem-text: root.bar-mem-text;
        date-text: root.date-text;
        anchor-clicked => { root.lens-open = !root.lens-open; root.open-lens(); }
        queue-clicked => { root.lens-open = true; root.open-lens(); }
        whisper-hint-clicked => { root.whisper-hint-clicked(); }
        settings-tapped => { root.quick-settings-open = !root.quick-settings-open; }
        power-pressed => { root.power-menu-open = !root.power-menu-open; }
        ai-privacy-clicked => { root.ai-privacy-clicked(); }
        active-harness-id: root.active-harness-id;
        active-harness-name: root.active-harness-name;
        active-mind-clicked => { root.active-mind-clicked(); }
    }

    // ── Layer 2: Desktop content area ──
    Rectangle {
        y: Theme.status-bar-height;
        width: 100%;
        height: root.height - Theme.status-bar-height;
        clip: true;

        // ── Wallpaper layer (lowest — below all backdrops) ──

        // Preset: Aurora (green/purple gradient)
        // ── Wallpaper ──
        //
        // Pre-rendered, not computed. These four were Slint gradient stacks — a linear base plus
        // three radial glows and a vignette, five full-screen passes — and the software
        // rasteriser re-evaluated all of them on EVERY repaint of the desktop. The desktop
        // repaints whenever a live value changes, which here is the clock and the CPU meter,
        // every two or three seconds, all day.
        //
        // Measured on VM 520, idle, nothing running:
        //     procedural gradient   6.6% of a core
        //     pre-rendered bitmap   1.5% of a core
        //
        // Mac and Windows ship bitmaps for exactly this reason. The pixels are identical — they
        // are generated from these same definitions by scripts/render-wallpapers.py, which is
        // committed beside them so the design stays editable and the PNGs stay reproducible.
        if root.wallpaper-path == "aurora" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/aurora.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "sunset" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/sunset.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "ocean" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/ocean.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "nebula" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/nebula.png");
            image-fit: fill;
        }

        if root.wallpaper-path != "" && root.wallpaper-path != "aurora" && root.wallpaper-path != "sunset" && root.wallpaper-path != "ocean" && root.wallpaper-path != "nebula" : Image {
            width: 100%; height: 100%;
            source: root.wallpaper-image;
            image-fit: cover;
        }

        // ── Deep space backdrop (dark mode) — only when no wallpaper ──
        if root.wallpaper-path == "" && ThemeMode.dark : Rectangle {
            width: 100%; height: 100%;

            // Animated phase for subtle backdrop movement
            property <float> bg-phase: 0;
            Timer {
                interval: max(16, root.ambient-interval-ms) * 1ms;
                running: root.ambient-interval-ms > 0;
                triggered => {
                    parent.bg-phase = mod(parent.bg-phase + 0.0008 * root.tick-scale, 1.0);
                }
            }

            // Base gradient (deep blue-black abyss)
            Rectangle {
                width: 100%; height: 100%;
                background: @radial-gradient(circle, #0a0a1c 0%, #050510 45%, #020206 100%);
            }
            // Nebula wash — upper right (cool cyan, breathing)
            Rectangle {
                x: parent.width * 0.6;
                y: -parent.height * 0.05;
                width: 600px; height: 500px;
                border-radius: 250px;
                background: @radial-gradient(circle, #5ac8d412 0%, #5ac8d406 40%, transparent 70%);
                opacity: 0.8 + 0.2 * sin(bg-phase * 6.2832 * 1rad);
            }
            // Nebula wash — lower left (warm amber)
            Rectangle {
                x: -50px;
                y: parent.height * 0.5;
                width: 550px; height: 450px;
                border-radius: 225px;
                background: @radial-gradient(circle, #d4a57412 0%, #d4a57406 40%, transparent 70%);
                opacity: 0.7 + 0.2 * sin(bg-phase * 4.712 * 1rad);
            }
            // Nebula wash — center (subtle purple, deeper)
            Rectangle {
                x: parent.width * 0.28;
                y: parent.height * 0.15;
                width: 800px; height: 600px;
                border-radius: 300px;
                background: @radial-gradient(circle, #c48bd40c 0%, #6040a008 30%, transparent 60%);
            }
            // Nebula wash — bottom center (holographic blue for orb area)
            Rectangle {
                x: parent.width * 0.3;
                y: parent.height * 0.6;
                width: 700px; height: 500px;
                border-radius: 250px;
                background: @radial-gradient(circle, #4ab8f008 0%, transparent 55%);
                opacity: 0.6 + 0.3 * sin(bg-phase * 5.341 * 1rad);
            }
            // Horizon glow — subtle light at the bottom edge
            Rectangle {
                y: parent.height - 200px;
                width: 100%;
                height: 200px;
                background: @linear-gradient(180deg,
                    transparent 0%,
                    #5ac8d406 60%,
                    #5ac8d40c 100%
                );
            }
            // Vignette overlay — deeper edges
            Rectangle {
                width: 100%; height: 100%;
                background: @radial-gradient(circle, transparent 20%, #00000030 55%, #00000080 100%);
            }
        }

        // ── Light mode backdrop — only when no wallpaper ──
        if root.wallpaper-path == "" && !ThemeMode.dark : Rectangle {
            width: 100%; height: 100%;
            background: @radial-gradient(circle, #f0f0f4 0%, #e4e4ec 50%, #d8d8e0 100%);
        }

        // Particle field (neurons + nebula clouds + ambient intelligence).
        //
        // NOT INSTANTIATED when the ambient budget is 0, which is the default on the software
        // rasteriser. This is a full-screen component carrying 18 blurs and 37 drop-shadows —
        // multi-pass convolutions that are the most expensive thing a CPU rasteriser does — and
        // it costs that on EVERY repaint, not only animated ones. Measured: a screen without it
        // repaints for 0.6% of a core; the desktop with it sat at 97%.
        //
        // Stopping its Timer was not enough, and the reason is the `animate` blocks below. Those
        // properties are re-set by system_poll every 3s while time-of-day eases over 5s, so the
        // component is permanently mid-animation and repaints continuously with the Timer idle.
        // An expensive full-screen layer has to be absent, not merely still.
        //
        // Nothing is lost functionally: this is pure backdrop with no TouchArea and no state the
        // user can read. The orb keeps its click target, which lives in the wrapper below.
        if root.ambient-interval-ms > 0 : ParticleField {
            ambient-interval-ms: root.ambient-interval-ms;
            width: 100%;
            height: 100%;
            active: true;
            intensity: root.focus-mode ? 0.15 : 0.7;
            is-thinking: root.is-thinking;
            has-urges: root.has-urges;
            sentiment: root.particle-sentiment;
            cognitive-load: root.particle-cognitive-load;
            time-of-day: root.particle-time-of-day;

            animate intensity { duration: 300ms; }
            animate sentiment { duration: 2000ms; }
            animate cognitive-load { duration: 1000ms; }
            animate time-of-day { duration: 5000ms; }
        }

        // ── The desktop's own right-click ──
        //
        // There was none, anywhere: YContextMenu has existed in the kit the whole time and was
        // never once instantiated. And the compositor's root menu cannot stand in for it, because
        // the shell is a fullscreen window — labwc's root is underneath it and unreachable, so a
        // right click anywhere on the desktop lands here and, until now, on nothing.
        //
        // Placed before the icons and the orb so those stay on top and keep their left clicks;
        // this only ever sees what they do not take.
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.desktop-menu-x = self.mouse-x;
                    root.desktop-menu-y = self.mouse-y;
                    root.desktop-menu-open = true;
                }
            }
        }

        // ── Desktop icons (human mode) ──
        // A desktop a person can use: the pinned apps sit on the wallpaper and
        // open on a click. Positioned rather than laid out, because a plain
        // Rectangle does not size to its children and the grid must not be able
        // to push the wallpaper around.
        if !root.agent-mode && !root.focus-mode : Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height - 40px;

            for item[i] in root.dock-items : Rectangle {
                // `row`/`col` are reserved (GridLayout attaches them to every element).
                property <int> icon-row: Math.floor(i / 6);
                property <int> icon-col: i - self.icon-row * 6;

                x: 28px + self.icon-col * 108px;
                y: 24px + self.icon-row * 104px;
                width: 96px;
                height: 92px;
                border-radius: Theme.r-md;
                background: icon-ta.has-hover ? Theme.hover-fill : transparent;
                animate background { duration: Theme.dur-fast; }

                icon-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.launch-app(item.app-id); }
                }

                VerticalLayout {
                    padding-top: 12px;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            commands: Icons.app-or-window(item.app-id);
                            size: 34px;
                            thickness: 1.5px;
                            tint: Theme.text-primary;
                        }
                    }

                    Text {
                        text: item.label;
                        color: Theme.text-secondary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                // A running app should say so without opening the switcher.
                if item.is-running : Rectangle {
                    x: (parent.width - 5px) / 2;
                    y: parent.height - 7px;
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.accent;
                }
            }
        }

        // ── Working set (left rail, hidden in focus mode) ──
        // What replaced the centred greeting. A desktop that shows the project, the recent
        // files and the memory count is a desktop that shows work; one that says "Good
        // evening" shows nothing. Every line here is data the shell already had.
        if root.agent-mode && !root.focus-mode : Rectangle {
            x: 0; y: 0;
            width: 296px;
            height: parent.height - 40px;
            background: Theme.bg-deep.transparentize(28%);

            Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.separator; }

            VerticalLayout {
                padding: Theme.sp-4;
                spacing: 0;

                Text { text: "PROJECT"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    padding-top: 6px;
                    Rectangle { width: 3px; height: 15px; y: (parent.height - 15px) / 2; border-radius: 1.5px; background: Theme.accent; }
                    Text {
                        text: root.active-project != "" ? root.active-project : "No active project";
                        color: root.active-project != "" ? Theme.text-primary : Theme.text-secondary;
                        font-size: Theme.fs-headline;
                        font-weight: Theme.fw-headline;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 1px; background: Theme.separator; }
                Rectangle { height: Theme.sp-3; }

                Text { text: "RECENT"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                Rectangle { height: 6px; }

                if root.lens-recents.length == 0 : Text {
                    text: "Nothing yet — open something.";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                }
                for r in root.lens-recents : TouchArea {
                    height: 28px;
                    mouse-cursor: pointer;
                    clicked => { root.lens-result-selected(r.action-id); }
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.r-sm;
                        background: parent.has-hover ? Theme.hover-fill : transparent;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            spacing: 9px;
                            Icon { commands: Icons.file; size: 13px; tint: Theme.text-dim; y: (parent.height - self.height) / 2; }
                            Text {
                                text: r.title;
                                color: Theme.text-primary;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.subtitle;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 90px;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: Theme.separator; }
                HorizontalLayout {
                    padding-top: Theme.sp-3;
                    spacing: Theme.sp-3;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: "MEMORIES"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                        Text { text: root.memory-count; color: Theme.text-primary; font-size: 17px; font-weight: 500; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: "PENDING"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                        Text { text: root.pending-count; color: root.pending-count > 0 ? Theme.accent : Theme.text-primary; font-size: 17px; font-weight: 500; }
                    }
                }
            }
        }

        // ── Ask bar (top of the content area, hidden in focus mode) ──
        // The Lens is the primary interaction; it should look like one, not like an orb
        // to be discovered. Clicking opens the same overlay the orb used to.
        if root.agent-mode && !root.focus-mode : TouchArea {
            x: 296px + Theme.sp-5;
            y: Theme.sp-4;
            width: parent.width - 296px - 318px - Theme.sp-5 * 2;
            height: 38px;
            mouse-cursor: pointer;
            clicked => { root.lens-open = true; root.open-lens(); }

            Rectangle {
                width: 100%; height: 100%;
                border-radius: Theme.r-md;
                background: Theme.bg-input;
                border-width: 1px;
                border-color: parent.has-hover ? Theme.accent-dim : Theme.border-strong;

                HorizontalLayout {
                    padding-left: 13px; padding-right: 10px;
                    spacing: Theme.sp-3;
                    Icon { commands: Icons.search; size: 15px; tint: Theme.text-dim; thickness: 1.7px; y: (parent.height - self.height) / 2; }
                    Text {
                        text: "Ask, search, or run anything";
                        color: Theme.text-dim;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: kbd.preferred-width + 12px;
                        height: 20px;
                        y: (parent.height - 20px) / 2;
                        border-radius: 4px;
                        background: Theme.hover-fill;
                        kbd := Text {
                            text: "Ctrl K";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── The centre: what the mind has, what is open, what you can start ──
        //
        // This was empty. Three quarters of an "AI at the core" desktop was bare wallpaper
        // between an ask bar and a taskbar, which is a strange thing for an OS whose entire
        // claim is that something is thinking in it.
        //
        // Everything here is data the shell already holds, and every section disappears when it
        // has nothing — a fresh machine genuinely has no suggestions, and inventing some would
        // be the confident lie this codebase keeps having to remove. What a fresh machine gets
        // instead is the one card at the bottom, which is true on day one and gone by day two.
        if root.agent-mode && !root.focus-mode : Flickable {
            x: 296px + Theme.sp-5;
            y: Theme.sp-4 + 38px + Theme.sp-4;
            width: parent.width - 296px - 318px - Theme.sp-5 * 2;
            height: parent.height - 40px - (Theme.sp-4 + 38px + Theme.sp-4) - Theme.sp-4;
            // Both, or the column lays itself out at its own preferred width and the cards sit
            // in a narrow ribbon down the middle of the space they were supposed to fill.
            viewport-width: self.width;
            viewport-height: centre-column.preferred-height;

            centre-column := VerticalLayout {
                width: parent.width;
                height: self.preferred-height;
                spacing: Theme.sp-4;
                alignment: start;

                // What the mind is proposing. GlanceCard has existed in the kit since the
                // instincts landed and had never once been placed on a screen.
                if root.urges.length > 0 : VerticalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: "SUGGESTIONS";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: Theme.fw-micro;
                        letter-spacing: 1px;
                    }
                    // Tapping one sends it to the mind — the suggestion IS a message it
                    // proposed saying to itself, so the honest action is to say it.
                    for u in root.urges : GlanceCard {
                        data: u;
                        tapped(msg) => { root.send-message(msg); }
                    }
                }

                // What is already open, so getting back to a window does not mean going to the
                // taskbar and reading it.
                if root.window-list.length > 0 : VerticalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: "OPEN";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: Theme.fw-micro;
                        letter-spacing: 1px;
                    }
                    for w in root.window-list : Rectangle {
                        height: 40px;
                        border-radius: Theme.r-md;
                        background: win-ta.has-hover ? Theme.hover-fill : Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        win-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.switch-window(w.title); }
                        }
                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: Theme.sp-3;
                            Text {
                                text: w.title;
                                color: Theme.text-primary;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Apps, because agent mode hides the desktop icons and the only way left to
                // start anything was the Apps button in the corner. A desktop you cannot open
                // anything from is not a more advanced desktop.
                if root.dock-items.length > 0 : VerticalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: "START";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: Theme.fw-micro;
                        letter-spacing: 1px;
                    }
                    Rectangle {
                        height: 84px;
                        border-radius: Theme.r-lg;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        clip: true;
                        // Scrolls, because the number of pinned apps is not something this row
                        // gets to decide. Clipping the last one in half — which it did — makes
                        // the desktop look broken rather than full.
                        Flickable {
                            width: 100%;
                            height: 100%;
                            viewport-width: root.dock-items.length * 72px + Theme.sp-3 * 2;
                            viewport-height: self.height;
                        HorizontalLayout {
                            padding: Theme.sp-3;
                            spacing: Theme.sp-2;
                            alignment: start;
                            for item[i] in root.dock-items : Rectangle {
                                width: 64px;
                                border-radius: Theme.r-md;
                                background: app-ta.has-hover ? Theme.hover-fill : transparent;
                                app-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.launch-app(item.app-id); }
                                }
                                VerticalLayout {
                                    padding-top: 8px;
                                    spacing: 4px;
                                    alignment: start;
                                    Icon {
                                        commands: Icons.app-or-window(item.app-id);
                                        size: 24px;
                                        // The dimmest tint in the palette is for metadata, not
                                        // for the only way to start a program.
                                        tint: app-ta.has-hover ? Theme.accent : Theme.text-primary;
                                        thickness: 1.6px;
                                        x: (parent.width - self.width) / 2;
                                    }
                                    Text {
                                        text: item.label;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-micro;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                        }
                    }
                }

                // Day one. Gone the moment any of the above has content, which is the only
                // honest way to fill a screen on a machine that has not been used yet.
                if root.urges.length == 0 && root.window-list.length == 0 : Rectangle {
                    height: day-one.preferred-height;
                    border-radius: Theme.r-lg;
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    day-one := VerticalLayout {
                        padding: Theme.sp-4;
                        spacing: Theme.sp-2;
                        alignment: start;
                        Text {
                            text: "Nothing is happening yet";
                            color: Theme.text-primary;
                            font-size: Theme.fs-headline;
                            font-weight: Theme.fw-headline;
                        }
                        Text {
                            text: "This desktop fills itself in as it learns what you are doing. Ask it something with Ctrl K, open an app below, and it will start keeping track of the work rather than the icons.";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-body;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── Focus Overlay (Workspace Morph) ──
        if root.focus-mode : VerticalLayout {
            alignment: center;
            spacing: 8px;

            // Large countdown timer
            Text {
                text: root.focus-remaining;
                color: Theme.text-primary;
                font-size: 72px;
                font-weight: 200;
                letter-spacing: 4px;
                horizontal-alignment: center;
                opacity: 0.85;
            }

            // Label
            Text {
                text: "remaining";
                color: Theme.text-dim;
                font-size: 14px;
                letter-spacing: 3px;
                horizontal-alignment: center;
                opacity: 0.5;
            }

            // Spacer
            Rectangle { height: 32px; }

            // End Focus button
            TouchArea {
                width: 120px;
                height: 36px;
                x: (parent.width - 120px) / 2;
                clicked => { root.end-focus-mode(); }

                Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: Theme.text-dim;
                    background: parent.has-hover ? Theme.hover-fill-strong : transparent;

                    Text {
                        text: "End Focus";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── Machine rail (right, hidden in focus mode) ──
        if root.agent-mode && !root.focus-mode : MachineRail {
            mind-name: root.active-harness-name;
            x: parent.width - self.width;
            y: 0;
            height: parent.height - 40px;
            cpu-percent: root.bar-cpu-percent;
            mem-percent: root.bar-mem-percent;
            mem-text: root.bar-mem-text;
            swap-percent: root.bar-swap-percent;
            swap-text: root.bar-swap-text;
            disk-percent: root.bar-disk-percent;
            disk-text: root.bar-disk-text;
            services: root.services;
            bond-level: root.bond-level;
            bond-score: root.bond-score;
            companion-online: root.companion-online;
            companion-status: root.companion-status;
            provider-label: root.ai-provider-label;
            memory-count: root.memory-count;
            whisper-count: root.whisper-hint-count;
        }

        // ── Taskbar (bottom edge) ──
        Taskbar {
            y: parent.height - self.height;
            width: 100%;
            windows: root.window-list;
            pins: root.dock-items;
            launcher-label: Tr.dock-apps;
            companion-count: root.whisper-hint-count;
            companion-online: root.companion-online;
            companion-status: root.companion-status;
            open-launcher => { root.app-grid-open = !root.app-grid-open; }
            activate-window(title) => { root.switch-window(title); }
            launch-app(app-id) => { root.launch-app(app-id); }
            open-companion => { root.lens-open = !root.lens-open; root.open-lens(); }
        }
    }

    // ── Layer 2.5: Quick Settings overlay (slide down from status bar) ──
    QuickSettings {
        width: 100%;
        height: 100%;
        is-open <=> root.quick-settings-open;
        battery-available: root.battery-available;
        battery-level: root.battery-level;
        battery-charging: root.battery-charging;
        wifi-connected: root.wifi-connected;
        wifi-ssid: "";
        brightness-level <=> root.brightness-level;
        volume-level <=> root.volume-level;
        toggle-wifi => { root.toggle-wifi(); }
        brightness-changed(val) => { root.brightness-changed(val); }
        volume-changed(val) => { root.volume-changed(val); }
        close => { root.quick-settings-open = false; }
    }

    // ── Layer 2.52: Power menu overlay ──
    PowerMenu {
        width: 100%;
        height: 100%;
        is-open <=> root.power-menu-open;
        power-action(action) => { root.power-action(action); }
        close => { root.power-menu-open = false; }
    }

    // ── Layer 2.53: App grid overlay ──
    AppGrid {
        width: 100%;
        height: 100%;
        is-open <=> root.app-grid-open;
        apps: root.grid-apps;
        categories: root.grid-categories;
        active-category: root.grid-active-category;
        category-selected(id) => { root.grid-category-selected(id); }
        launch-app(app-id) => { root.grid-launch-app(app-id); }
        close => { root.app-grid-open = false; }
        search-changed(query) => { root.grid-search-apps(query); }
    }

    // ── Layer 2.54: Window switcher overlay ──
    WindowSwitcher {
        width: 100%;
        height: 100%;
        is-open <=> root.window-switcher-open;
        windows: root.window-list;
        switch-window(title) => { root.switch-window(title); }
        close => { root.window-switcher-open = false; }
    }

    // ── Layer 2.56: Command Palette overlay ──
    CommandPalette {
        width: 100%;
        height: 100%;
        is-open <=> root.command-palette-open;
        filtered-commands: root.command-palette-filtered;
        search-changed(query) => { root.command-palette-search(query); }
        command-selected(action-id) => { root.command-palette-selected(action-id); }
        close => { root.command-palette-open = false; }
    }

    // ── Layer 2.55: Clipboard history panel ──
    ClipboardPanel {
        width: 100%;
        height: 100%;
        is-open <=> root.clip-panel-open;
        entries: root.clip-panel-entries;
        search-query <=> root.clip-search-query;
        paste-entry(idx) => { root.clipboard-paste(idx); }
        search-changed(query) => { root.clipboard-search(query); }
        close => { root.clip-panel-open = false; }
    }

    // ── Layer 2.6: Whisper Cards (floating, top-right) ──
    WhisperCardStack {
        x: root.width - 316px;
        y: Theme.status-bar-height + 8px;
        cards: root.whisper-cards;
        card-dismissed(id) => { root.whisper-card-dismissed(id); }
        card-action(id) => { root.whisper-card-action(id); }
    }

    // ── Layer 2.7: Morning Brief Card (floating, upper-left) ──
    MorningBriefCard {
        // Top-left is where the desktop icons live now, and the brief was landing
        // on top of them. In agent mode there are no icons, so it keeps its corner.
        x: root.agent-mode ? 24px : parent.width - self.width - 24px;
        y: Theme.status-bar-height + 16px;
        // A child of a plain Rectangle fills its parent by default, so the card
        // ignored its own preferred-height and ran the whole height of the screen.
        height: self.preferred-height;
        show-card: root.morning-brief-visible;
        greeting: root.morning-brief-greeting;
        sections: root.morning-brief-sections;
        dismissed => { root.morning-brief-dismissed(); }
        section-action(id) => { root.morning-brief-section-action(id); }
    }

    // ── Layer 3: Intent Lens overlay ──
    IntentLens {
        is-open: root.lens-open;
        is-thinking: root.is-thinking;
        results: root.lens-results;
        companion-status: root.companion-status;
        companion-online: root.companion-online;
        chat-mode: root.lens-chat-mode;
        messages: root.messages;
        is-generating: root.is-generating;
        suggestions: root.lens-suggestions;
        recents: root.lens-recents;

        query-changed(text) => { root.lens-query(text); }
        submit-query(text) => { root.lens-submit(text); }
        result-selected(id) => { root.lens-result-selected(id); }
        close-lens => {
            root.lens-open = false;
            root.close-lens();
        }
        send-message(text) => { root.send-message(text); }
        mic-pressed => { root.mic-pressed(); }
    }

    // Last in the file so it draws over the icons, the orb and the taskbar. A menu that opened
    // underneath the thing it was summoned from would be worse than no menu.
    if root.desktop-menu-open : YContextMenu {
        open: true;
        // Kept inside the screen when summoned near an edge: the panel is 220px wide and each
        // row is 32px, so a click in the bottom-right corner would otherwise open a menu mostly
        // off-screen.
        menu-x: min(root.desktop-menu-x, root.width - 232px);
        menu-y: min(root.desktop-menu-y, root.height - 200px);
        actions: [
            { id: "terminal", label: "Open Terminal" },
            { id: "files", label: "Open Files", separator-after: true },
            { id: "launchpad", label: "All Apps" },
            { id: "devices", label: "Devices", separator-after: true },
            { id: "settings", label: "Settings" },
        ];
        action-clicked(id) => {
            root.desktop-menu-open = false;
            root.launch-app(id);
        }
        close-menu => { root.desktop-menu-open = false; }
    }
}
