// Weather Dashboard — screen 19.
// Current conditions, hourly forecast, 5-day forecast, weather details.
// Saved locations, unit toggle, severe weather alerts, last updated, AQI.

import { Theme } from "theme.slint";
import { YButton, YIconButton } from "components/y_button.slint";
import { YInput } from "components/y_input.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { Icon, Icons } from "components/icon.slint";

// ── Data structs ──

export struct WeatherCurrent {
    temperature: string,
    feels-like: string,
    condition: string,
    icon: string,
    location: string,
    humidity: string,
    wind-speed: string,
    wind-direction: string,
    uv-index: string,
    visibility: string,
    pressure: string,
    cloud-cover: string,
    dew-point: string,
    sunrise: string,
    sunset: string,
    // Drives the warm/cool tint on the headline icon; the icon KIND already
    // carries sun-vs-moon, this colours it.
    is-day: bool,
    is-loading: bool,
    error-text: string,
}

export struct WeatherHourly {
    time: string,
    icon: string,
    temp: string,
    precip: string,
    is-current: bool,
    // Absolute temperature plus the min/max across the whole strip, so each
    // column can show where this hour sits in the day's range.
    temp-value: float,
    t-min: float,
    t-max: float,
}

export struct WeatherDaily {
    day-name: string,
    icon: string,
    high: string,
    low: string,
    precip-chance: string,
    high-value: float,
    low-value: float,
    temp-range-min: float,
    temp-range-max: float,
}

export struct WeatherSavedLocation {
    name: string,
    lat: float,
    lon: float,
    is-active: bool,
}

export struct WeatherAlert {
    title: string,
    description: string,
    severity: int,   // 0=info, 1=moderate, 2=severe
    icon: string,
}

// One reading from the current conditions. Fixed height so a grid of these lines
// up, and the label sits above the value with room of its own — the old row put
// four labels side by side and they collided.
component MetricTile inherits Rectangle {
    in property <string> icon-path;
    in property <string> value;
    in property <string> label;

    horizontal-stretch: 1;
    // Without this the tile's minimum comes from its own text, so a wide value
    // like "13 km/h" makes its column wider than the one beside it and the rows
    // stop lining up. At 0 every tile takes an identical share of the grid.
    min-width: 0px;
    height: 64px;
    border-radius: Theme.r-md;
    background: Theme.bg-surface;
    border-width: 1px;
    border-color: Theme.border-subtle;

    // An icon column, then one text rail: the label and the value start at the
    // same x. Stacking the icon inline with the label indented only the label,
    // which left the two lines of the tile disagreeing about their left edge.
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon-path;
                size: 15px;
                tint: Theme.text-dim;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                color: Theme.text-dim;
                font-size: 10px;
                letter-spacing: 0.5px;
                overflow: elide;
            }

            Text {
                text: root.value;
                color: Theme.text-primary;
                font-size: 19px;
                font-weight: 600;
                overflow: elide;
            }
        }
    }
}

export component WeatherDashboard inherits Rectangle {
    background: Theme.bg-deep;

    // The hero is a two-column grid: an icon column and a text column. Both the
    // temperature and the lines under it measure from the same left edge.
    // One height for the location pill, the unit toggle and the AI button,
    // so the header reads as one row of controls.
    property <length> CHIP-H: 32px;
    property <length> HERO-ICON: 60px;
    property <length> HERO-GUTTER: 18px;
    // Explicit, because a stretch factor only shares the SURPLUS: each tile still
    // claims a minimum from its own text, so "1020 hPa" made its column wider
    // than "92%" and the grid rows drifted out of line.
    property <length> HERO-TILE: 161px;

    in property <WeatherCurrent> current: {
        temperature: "--",
        feels-like: "--",
        condition: "Loading...",
        icon: "...",
        location: "...",
        humidity: "--",
        wind-speed: "--",
        wind-direction: "--",
        uv-index: "--",
        visibility: "--",
        pressure: "--",
        cloud-cover: "--",
        dew-point: "--",
        sunrise: "--",
        sunset: "--",
        is-loading: true,
        error-text: "",
    };
    in property <[WeatherHourly]> hourly: [];
    in property <[WeatherDaily]> daily: [];

    callback back-pressed();
    callback refresh-pressed();

    // AI Assist
    in property <bool> ai-is-working: false;
    in property <string> ai-response: "";
    in-out property <bool> ai-panel-open: false;
    callback ai-explain-pressed();
    callback ai-dismiss();

    // Saved locations
    in property <[WeatherSavedLocation]> weather-saved-locations: [];
    in-out property <bool> weather-location-panel-open: false;
    in-out property <string> weather-add-location-text: "";
    callback weather-select-location(int);
    callback weather-add-location(string);
    callback weather-remove-location(int);

    // Units toggle (false = Celsius, true = Fahrenheit)
    in-out property <bool> weather-use-fahrenheit: false;
    callback weather-toggle-units();

    // Severe weather alerts
    in property <[WeatherAlert]> weather-alerts: [];

    // Severe weather alert banner
    in property <bool> weather-severe-alert-active: false;
    in property <string> weather-severe-alert-text: "";
    in property <string> weather-severe-alert-level: "";  // "watch", "warning", "emergency"

    // Last updated
    in property <string> weather-last-updated: "";

    // AQI (Air Quality Index)
    in property <string> weather-aqi-value: "--";
    in property <string> weather-aqi-label: "N/A";
    in property <int> weather-aqi-level: 0;  // 0=good, 1=moderate, 2=unhealthy

    VerticalLayout {
        width: 100%;
        height: 100%;

        // ── Header bar ──
        Rectangle {
            height: Theme.sp-9;
            background: Theme.bg-surface;

            // Bottom divider
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.separator;
            }

            // Every control here sits in its own centring column. A fixed-height
            // child of a HorizontalLayout does not centre itself, and `y:` on a
            // layout child is ignored — between them the chips sat high while the
            // title, timestamp and refresh sat low.
            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-4;
                spacing: Theme.sp-3;

                VerticalLayout {
                    alignment: center;
                    YIconButton {
                        icon-path: Icons.arrow-left;
                        variant: 2;
                        clicked => { root.back-pressed(); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Weather";
                        color: Theme.text-primary;
                        font-size: Theme.fs-title-2;
                        font-weight: Theme.fw-title-2;
                    }
                }

                // The place and when it was last read belong together; the
                // timestamp was floating on its own in the middle of the bar.
                VerticalLayout {
                    alignment: center;

                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;

                        TouchArea {
                            width: loc-btn-row.preferred-width + 20px;
                            height: root.CHIP-H;
                            clicked => {
                                root.weather-location-panel-open = !root.weather-location-panel-open;
                            }
                            Rectangle {
                                height: root.CHIP-H;
                                border-radius: Theme.r-pill;
                                background: root.weather-location-panel-open ? Theme.tint-accent
                                    : (parent.has-hover ? Theme.hover-fill-strong : Theme.bg-card);
                                border-width: 1px;
                                border-color: root.weather-location-panel-open ? Theme.accent-dim
                                    : Theme.border-subtle;

                                loc-btn-row := HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    alignment: center;

                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            commands: Icons.pin;
                                            size: 12px;
                                            tint: Theme.text-secondary;
                                        }
                                    }

                                    Text {
                                        text: root.current.location;
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            commands: Icons.chevron-down;
                                            size: 12px;
                                            tint: Theme.text-dim;
                                        }
                                    }
                                }
                            }
                        }

                        if root.weather-last-updated != "" : VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.weather-last-updated;
                                color: Theme.text-dim;
                                font-size: 11px;
                            }
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Units toggle — same height as the chips beside it.
                VerticalLayout {
                    alignment: center;
                    TouchArea {
                        width: 62px;
                        height: root.CHIP-H;
                        clicked => {
                            root.weather-use-fahrenheit = !root.weather-use-fahrenheit;
                            root.weather-toggle-units();
                        }
                        Rectangle {
                            width: 62px;
                            height: root.CHIP-H;
                            border-radius: root.CHIP-H / 2;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            Rectangle {
                                width: 29px;
                                height: root.CHIP-H - 6px;
                                x: root.weather-use-fahrenheit ? 30px : 3px;
                                y: 3px;
                                border-radius: (root.CHIP-H - 6px) / 2;
                                background: Theme.accent;
                                animate x { duration: 150ms; easing: ease-out; }
                            }

                            Text {
                                text: "\u{00B0}C";
                                x: 3px;
                                width: 29px;
                                height: 100%;
                                color: root.weather-use-fahrenheit ? Theme.text-dim : Theme.text-on-accent;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: "\u{00B0}F";
                                x: 30px;
                                width: 29px;
                                height: 100%;
                                color: root.weather-use-fahrenheit ? Theme.text-on-accent : Theme.text-dim;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TouchArea {
                        width: ai-wx-btn.preferred-width + 20px;
                        height: root.CHIP-H;
                        clicked => {
                            if root.ai-panel-open {
                                root.ai-dismiss();
                                root.ai-panel-open = false;
                            } else {
                                root.ai-explain-pressed();
                                root.ai-panel-open = true;
                            }
                        }
                        ai-wx-btn := Rectangle {
                            height: root.CHIP-H;
                            border-radius: Theme.r-pill;
                            background: root.ai-is-working ? Theme.accent
                                : (parent.has-hover ? Theme.hover-fill-strong : Theme.bg-card);
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        commands: Icons.spark;
                                        size: 12px;
                                        tint: root.ai-is-working ? Theme.text-on-accent : Theme.text-secondary;
                                    }
                                }

                                Text {
                                    text: root.ai-is-working ? "Analyzing..." : "AI Insights";
                                    color: root.ai-is-working ? Theme.text-on-accent : Theme.text-secondary;
                                    font-size: 11px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.CHIP-H;
                        height: root.CHIP-H;
                        border-radius: root.CHIP-H / 2;
                        background: ta-refresh.has-hover ? Theme.hover-fill-strong : transparent;

                        ta-refresh := TouchArea {
                            clicked => { root.refresh-pressed(); }
                        }

                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    commands: Icons.refresh;
                                    size: 17px;
                                    tint: Theme.accent;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Location Selector Panel ──
        if root.weather-location-panel-open : Rectangle {
            height: min(240px, loc-panel-col.preferred-height);
            background: Theme.bg-surface;
            border-width: 1px;
            border-color: Theme.border-subtle;

            Flickable {
                viewport-height: loc-panel-col.preferred-height;

                loc-panel-col := VerticalLayout {
                    alignment: start;
                    padding: 12px;
                    spacing: 6px;

                    // Add location row
                    HorizontalLayout {
                        spacing: 8px;
                        height: 36px;

                        Rectangle {
                            horizontal-stretch: 1;
                            height: 36px;
                            border-radius: 8px;
                            background: Theme.bg-card;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            clip: true;

                            loc-input := TextInput {
                                text <=> root.weather-add-location-text;
                                font-size: 12px;
                                color: Theme.text-primary;
                                width: parent.width - 16px;
                                x: 8px;
                                vertical-alignment: center;
                                accepted => {
                                    if root.weather-add-location-text != "" {
                                        root.weather-add-location(root.weather-add-location-text);
                                        root.weather-add-location-text = "";
                                    }
                                }
                            }

                            // Placeholder
                            if root.weather-add-location-text == "" : Text {
                                text: "Add city...";
                                color: Theme.text-dim;
                                font-size: 12px;
                                x: 8px;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            width: 36px;
                            height: 36px;
                            clicked => {
                                if root.weather-add-location-text != "" {
                                    root.weather-add-location(root.weather-add-location-text);
                                    root.weather-add-location-text = "";
                                }
                            }
                            add-loc-btn := Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 8px;
                                background: parent.has-hover ? Theme.accent : Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                Text {
                                    text: "+";
                                    color: add-loc-btn.background == Theme.accent ? Theme.text-on-accent : Theme.accent;
                                    font-size: 16px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Saved locations list
                    for loc[idx] in root.weather-saved-locations : Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: loc.is-active ? Theme.tint-accent : (ta-loc.has-hover ? Theme.hover-fill : transparent);
                        border-width: loc.is-active ? 1px : 0px;
                        border-color: loc.is-active ? Theme.accent-dim : transparent;

                        ta-loc := TouchArea {
                            clicked => {
                                root.weather-select-location(idx);
                                root.weather-location-panel-open = false;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 8px;

                            Icon {
                                commands: Icons.pin;
                                size: 14px;
                                tint: Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: loc.name;
                                color: loc.is-active ? Theme.accent : Theme.text-primary;
                                font-size: 13px;
                                font-weight: loc.is-active ? 600 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if loc.is-active : Icon {
                                commands: Icons.check;
                                size: 14px;
                                tint: Theme.accent;
                                y: (parent.height - self.height) / 2;
                            }

                            // Remove button
                            TouchArea {
                                width: 28px;
                                height: 28px;
                                clicked => { root.weather-remove-location(idx); }
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                    Icon {
                                        commands: Icons.close;
                                        size: 12px;
                                        tint: Theme.text-dim;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Severe Weather Alerts ──
        for alert[ai] in root.weather-alerts : Rectangle {
            height: 44px;
            background: alert.severity >= 2 ? Theme.color-emotional.transparentize(85%)
                       : alert.severity == 1 ? Theme.amber.transparentize(85%)
                       : Theme.accent.transparentize(85%);
            border-width: 1px;
            border-color: alert.severity >= 2 ? Theme.color-emotional.transparentize(50%)
                         : alert.severity == 1 ? Theme.amber.transparentize(50%)
                         : Theme.accent.transparentize(50%);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;

                Text {
                    text: alert.icon;
                    font-size: 18px;
                    vertical-alignment: center;
                }

                Text {
                    text: alert.title;
                    color: alert.severity >= 2 ? Theme.color-emotional
                          : alert.severity == 1 ? Theme.amber
                          : Theme.accent;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: alert.description;
                    color: alert.severity >= 2 ? Theme.color-emotional.transparentize(20%)
                          : alert.severity == 1 ? Theme.amber-light
                          : Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // Severity badge
                Rectangle {
                    width: sev-text.preferred-width + 12px;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: 10px;
                    background: alert.severity >= 2 ? Theme.color-emotional.transparentize(60%)
                               : alert.severity == 1 ? Theme.amber.transparentize(60%)
                               : Theme.accent.transparentize(60%);
                    sev-text := Text {
                        text: alert.severity >= 2 ? "SEVERE"
                             : alert.severity == 1 ? "MODERATE"
                             : "INFO";
                        color: alert.severity >= 2 ? Theme.color-emotional
                              : alert.severity == 1 ? Theme.amber
                              : Theme.accent;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── AI Response Panel ──
        if root.ai-panel-open && root.ai-response != "" : Rectangle {
            height: min(160px, ai-wx-resp.preferred-height + 16px);
            background: Theme.bg-overlay-panel;
            border-width: 1px;
            border-color: Theme.accent.transparentize(70%);

            Flickable {
                viewport-height: ai-wx-resp.preferred-height + 16px;

                ai-wx-resp := VerticalLayout {
                    alignment: start;
                    padding: Theme.sp-3;
                    spacing: Theme.sp-2;

                    HorizontalLayout {
                        spacing: 6px;
                        Icon {
                            commands: Icons.spark;
                            size: 12px;
                            tint: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "AI Insights";
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        YIconButton {
                            icon-path: Icons.close;
                            variant: 2;
                            clicked => {
                                root.ai-panel-open = false;
                                root.ai-dismiss();
                            }
                        }
                    }

                    Text {
                        text: root.ai-response;
                        color: Theme.text-primary;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── Scrollable content ──
        Flickable {
            viewport-height: content-col.preferred-height + 40px;

            content-col := VerticalLayout {
                alignment: start;
                padding: Theme.sp-5;
                spacing: Theme.sp-4;

                // ══════ ERROR BANNER ══════
                if root.current.error-text != "" : Rectangle {
                    background: Theme.color-danger-dim;
                    border-radius: Theme.r-lg;
                    border-width: 1px;
                    border-color: Theme.color-danger.with-alpha(0.25);
                    height: 48px;

                    Text {
                        text: root.current.error-text;
                        color: Theme.color-danger;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // ══════ SEVERE WEATHER ALERT BANNER ══════
                if root.weather-severe-alert-active : Rectangle {
                    background: root.weather-severe-alert-level == "watch" ? Theme.color-warning-dim
                        : root.weather-severe-alert-level == "warning" ? Theme.color-danger-dim
                        : root.weather-severe-alert-level == "emergency" ? Theme.color-danger.with-alpha(0.19)
                        : Theme.color-warning-dim;
                    border-radius: Theme.r-lg;
                    border-width: 1px;
                    border-color: root.weather-severe-alert-level == "watch" ? Theme.color-warning.with-alpha(0.37)
                        : Theme.color-danger.with-alpha(0.37);
                    height: severe-alert-row.preferred-height + 16px;

                    severe-alert-row := HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        alignment: center;

                        Icon { commands: Icons.warning; size: 20px; tint: root.weather-severe-alert-level == "watch" ? Theme.amber : Theme.color-danger; thickness: 1.8px; y: (parent.height - self.height) / 2; }

                        VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: root.weather-severe-alert-level == "watch" ? "Weather Watch"
                                    : root.weather-severe-alert-level == "warning" ? "Weather Warning"
                                    : "Weather Emergency";
                                font-size: Theme.fs-body;
                                font-weight: 700;
                                color: root.weather-severe-alert-level == "watch" ? Theme.color-warning
                                    : Theme.color-danger;
                            }

                            Text {
                                text: root.weather-severe-alert-text;
                                font-size: Theme.fs-caption;
                                color: root.weather-severe-alert-level == "watch" ? Theme.color-warning
                                    : Theme.color-danger;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // ══════ HERO SECTION — Current Conditions ══════
                Rectangle {
                    // A weather panel should have some air in it; a flat fill read as a form.
                    background: @linear-gradient(160deg, Theme.bg-elevated 0%, Theme.bg-card 70%);
                    border-radius: Theme.r-lg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    height: hero-col.preferred-height;

                    // Subtle accent glow at top
                    Rectangle {
                        height: 2px;
                        width: parent.width;
                        y: 0;
                        background: Theme.accent-glow;
                        border-radius: 1px;
                    }

                    hero-col := VerticalLayout {
                        padding: Theme.sp-6;
                        spacing: Theme.sp-4;

                        // Loading indicator
                        if root.current.is-loading : Text {
                            text: "Fetching weather data...";
                            color: Theme.text-dim;
                            font-size: Theme.fs-body;
                            horizontal-alignment: center;
                        }

                        // ── The reading, then today's numbers beside it ──
                        HorizontalLayout {
                            spacing: 24px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 6px;

                                // Row 1: the icon on the temperature's own line. Centring it
                                // against the whole stack pushed it below the number.
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: HERO-GUTTER;

                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            commands: Icons.weather-kind(root.current.icon);
                                            size: HERO-ICON;
                                            thickness: 1.25px;
                                            tint: root.current.is-day ? Theme.amber : Theme.holo-blue;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: root.current.temperature;
                                            color: Theme.text-primary;
                                            font-size: 62px;
                                            font-weight: 250;
                                        }
                                    }
                                }

                                // Row 2: indented past the icon column so these sit under the
                                // temperature, not under the icon. One left edge for both lines.
                                HorizontalLayout {
                                    alignment: start;

                                    Rectangle { width: HERO-ICON + HERO-GUTTER; }

                                    VerticalLayout {
                                        spacing: 2px;

                                        Text {
                                            text: root.current.condition;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-headline;
                                            font-weight: 500;
                                        }

                                        Text {
                                            text: "Feels like " + root.current.feels-like;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                width: 3 * root.HERO-TILE + 2 * 8px;
                                alignment: center;
                                spacing: 8px;

                                HorizontalLayout {
                                    spacing: 8px;
                                    MetricTile {
                                        width: root.HERO-TILE;
                                        icon-path: Icons.droplet;
                                        value: root.current.humidity;
                                        label: "HUMIDITY";
                                    }
                                    MetricTile {
                                        width: root.HERO-TILE;
                                        icon-path: Icons.wind;
                                        value: root.current.wind-speed;
                                        label: "WIND " + root.current.wind-direction;
                                    }
                                    MetricTile {
                                        width: root.HERO-TILE;
                                        icon-path: Icons.sun;
                                        value: root.current.uv-index;
                                        label: "UV INDEX";
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    MetricTile {
                                        width: root.HERO-TILE;
                                        icon-path: Icons.eye;
                                        value: root.current.visibility;
                                        label: "VISIBILITY";
                                    }
                                    MetricTile {
                                        width: root.HERO-TILE;
                                        icon-path: Icons.compass;
                                        value: root.current.pressure;
                                        label: "PRESSURE";
                                    }
                                    MetricTile {
                                        width: root.HERO-TILE;
                                        icon-path: Icons.cloud;
                                        value: root.current.cloud-cover;
                                        label: "CLOUD COVER";
                                    }
                                }
                            }
                        }
                    }
                }

                // ══════ HOURLY FORECAST ══════
                // Section header
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.accent-glow;
                    }
                    Text {
                        text: "HOURLY FORECAST";
                        color: Theme.text-dim;
                        font-size: 11px;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.r-lg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    // Tall enough for time + icon + temp + the column + rain chance.
                    // At 110px the columns and the rain line were clipped away.
                    height: 168px;
                    clip: true;

                    Flickable {
                        width: parent.width - Theme.sp-4;
                        x: Theme.sp-2;
                        height: parent.height;
                        viewport-width: hourly.length * 70px + Theme.sp-4;

                        HorizontalLayout {
                            alignment: start;
                            padding: Theme.sp-2;
                            spacing: Theme.sp-1;

                            for hour[i] in root.hourly : Rectangle {
                                width: 64px;
                                border-radius: Theme.r-md;
                                background: hour.is-current ? Theme.tint-accent : transparent;
                                border-width: hour.is-current ? 1px : 0px;
                                border-color: hour.is-current ? Theme.accent-dim : transparent;

                                VerticalLayout {
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 6px;

                                    Text {
                                        text: hour.time;
                                        color: hour.is-current ? Theme.accent : Theme.text-dim;
                                        font-size: 11px;
                                        font-weight: hour.is-current ? 700 : 500;
                                        horizontal-alignment: center;
                                    }

                                    HorizontalLayout {
                                        alignment: center;
                                        Icon {
                                            commands: Icons.weather-kind(hour.icon);
                                            size: 20px;
                                            tint: hour.is-current ? Theme.accent : Theme.text-secondary;
                                        }
                                    }

                                    Text {
                                        text: hour.temp;
                                        color: Theme.text-primary;
                                        font-size: 14px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                    }

                                    // A column per hour, so the strip reads as the shape of the
                                    // day. The old 3px sliver read as dirt on the screen.
                                    Rectangle {
                                        height: 38px;

                                        VerticalLayout {
                                            alignment: end;

                                            HorizontalLayout {
                                                alignment: center;

                                                Rectangle {
                                                    width: 7px;
                                                    // Mostly baseline, a little range: a 3-degree
                                                    // day is genuinely flat, and a chart that
                                                    // amplifies it to full height lies about it
                                                    // while the cold end vanishes to a dot.
                                                    height: 15px + 21px * (hour.t-max > hour.t-min
                                                        ? (hour.temp-value - hour.t-min) / (hour.t-max - hour.t-min)
                                                        : 0.5);
                                                    border-radius: 3.5px;
                                                    background: hour.is-current
                                                        ? Theme.accent
                                                        : Theme.amber.transparentize(0.35);
                                                }
                                            }
                                        }
                                    }

                                    // Rain chance annotates the hour; it should not outshout
                                    // the temperature the way bright teal did.
                                    Text {
                                        text: hour.precip;
                                        color: Theme.text-secondary;
                                        font-size: 10px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ══════ 5-DAY FORECAST ══════
                // Section header
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.amber;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.amber-glow;
                    }
                    Text {
                        text: "5-DAY FORECAST";
                        color: Theme.text-dim;
                        font-size: 11px;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.r-lg;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    height: daily-col.preferred-height;

                    daily-col := VerticalLayout {
                        padding: 8px;
                        spacing: 0px;

                        for day[i] in root.daily : Rectangle {
                            height: 56px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;

                                Text {
                                    text: day.day-name;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                    width: 72px;
                                }

                                HorizontalLayout {
                                    width: 32px;
                                    alignment: center;
                                    Icon {
                                        commands: Icons.weather-kind(day.icon);
                                        size: 22px;
                                        tint: Theme.text-secondary;
                                    }
                                }

                                Text {
                                    text: day.precip-chance;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                    width: 48px;
                                    horizontal-alignment: right;
                                }

                                // Low at the cold end, high at the warm end, bar between them —
                                // one range to read, instead of a bar plus two numbers parked
                                // together at the far right.
                                Text {
                                    text: day.low;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    width: 40px;
                                    horizontal-alignment: right;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;

                                    Rectangle {
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.bg-surface;

                                        Rectangle {
                                            x: parent.width * clamp(day.temp-range-min, 0, 1);
                                            width: parent.width * clamp(day.temp-range-max - day.temp-range-min, 0.06, 1);
                                            height: parent.height;
                                            border-radius: 4px;
                                            background: @linear-gradient(90deg,
                                                Theme.holo-blue 0%, Theme.accent 55%, Theme.amber 100%);
                                        }
                                    }
                                }

                                Text {
                                    text: day.high;
                                    color: Theme.text-primary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    width: 40px;
                                    horizontal-alignment: left;
                                }
                            }

                            // Separator
                            Rectangle {
                                height: 1px;
                                x: 16px;
                                width: parent.width - 32px;
                                y: parent.height - 1px;
                                background: Theme.separator;
                            }
                        }
                    }
                }

                // ══════ WEATHER DETAILS GRID ══════
                // Section header
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.accent-glow;
                    }
                    Text {
                        text: "DETAILS";
                        color: Theme.text-dim;
                        font-size: 11px;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                // Details grid (2 columns)
                HorizontalLayout {
                    spacing: 12px;

                    // Left column
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;

                        // Sunrise
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.sunrise;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Sunrise";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.sunrise;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Pressure
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.chart;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Pressure";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.pressure;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Cloud Cover
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.cloud;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Cloud Cover";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.cloud-cover;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // AQI Card
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.wind;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Air Quality";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    // AQI level badge
                                    Rectangle {
                                        width: aqi-badge-text.preferred-width + 10px;
                                        height: 18px;
                                        border-radius: 9px;
                                        background: root.weather-aqi-level == 0 ? Theme.color-success-dim
                                                   : root.weather-aqi-level == 1 ? Theme.amber.transparentize(70%)
                                                   : Theme.color-emotional.transparentize(70%);
                                        aqi-badge-text := Text {
                                            text: root.weather-aqi-label;
                                            color: root.weather-aqi-level == 0 ? Theme.color-success
                                                  : root.weather-aqi-level == 1 ? Theme.amber
                                                  : Theme.color-emotional;
                                            font-size: 9px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: root.weather-aqi-value;
                                    color: root.weather-aqi-level == 0 ? Theme.color-success
                                          : root.weather-aqi-level == 1 ? Theme.amber
                                          : Theme.color-emotional;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }

                    // Right column
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 12px;

                        // Sunset
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.sunset;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Sunset";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.sunset;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Dew Point
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.droplet;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Dew Point";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.dew-point;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Precipitation
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.rain;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Precip.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.dew-point != "--" ? "See daily" : "--";
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }

                        // Wind Direction detail
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 72px;

                            VerticalLayout {
                                padding: 12px;
                                spacing: 4px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    Icon {
                                        commands: Icons.compass;
                                        size: 16px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "Wind Dir.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.current.wind-direction;
                                    color: Theme.text-primary;
                                    font-size: 18px;
                                    font-weight: 600;
                                }
                            }
                        }
                    }
                }

                // Bottom spacer
                Rectangle { height: 40px; }
            }
        }
    }
}
