// MachineRail — the right-hand rail: what the machine and the companion are doing.
//
// Load meters, the out-of-process services and their state, and the companion's own
// vitals. Every value here is already produced somewhere in the shell (the observer poll,
// the service manager, the bond system); this is the first place they are all visible at
// once without opening a dashboard.
//
// Still by design: no easing on the meters. A bar that animates towards its value reads as
// motion when the value is actually flat, and this rail is glanced at, not watched.

import { Theme } from "theme.slint";

export struct ServiceItem {
    id: string,
    status: string,   // running | starting | stopped | failed
    note: string,     // short right-hand detail: "up", "autostart", an error
}

component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-size: Theme.fs-micro;
    font-weight: Theme.fw-micro;
    letter-spacing: 1px;
}

component Meter inherits VerticalLayout {
    vertical-stretch: 0;
    in property <string> name;
    in property <string> value-text;
    in property <int> percent: 0;
    in property <color> tone: Theme.accent;

    spacing: 4px;
    padding-bottom: 9px;

    HorizontalLayout {
        Text {
            text: root.name;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: root.value-text;
            color: Theme.text-primary;
            font-size: Theme.fs-caption;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 3px;
        border-radius: 1.5px;
        background: Theme.border-strong;
        Rectangle {
            x: 0;
            height: 3px;
            width: parent.width * max(0, min(100, root.percent)) / 100;
            border-radius: 1.5px;
            background: root.tone;
        }
    }
}

component KeyValue inherits HorizontalLayout {
    vertical-stretch: 0;
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;
    spacing: Theme.sp-2;
    Text {
        text: root.key;
        color: Theme.text-secondary;
        font-size: Theme.fs-caption;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: root.value-color;
        font-size: Theme.fs-caption;
        font-weight: 500;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        max-width: 160px;
    }
}

export component MachineRail inherits Rectangle {
    in property <int> cpu-percent: 0;
    in property <int> mem-percent: 0;
    in property <string> mem-text: "";
    in property <int> swap-percent: 0;
    in property <string> swap-text: "";
    in property <int> disk-percent: 0;
    in property <string> disk-text: "";
    in property <[ServiceItem]> services: [];
    // False until the worker has pushed the store's bond. The default level here used to be
    // "Stranger", and the rail drew it as the relationship while the store was still opening.
    in property <bool> bond-loaded: false;
    in property <string> bond-level: "";
    in property <float> bond-score: 0.0;
    in property <bool> companion-online: true;
    in property <string> companion-status: "idle";
    in property <string> provider-label: "";
    in property <int> memory-count: 0;
    in property <int> whisper-count: 0;
    // Which mind is answering, and what it is running on. "Model" alone could not say that a
    // different harness had taken over the conversation.
    in property <string> mind-name: "";
    // What the mind says it is running on. Only an attached harness has one — the built-in
    // companion's model is `provider-label`, which is the shell's own configuration.
    in property <string> mind-detail: "";

    // 302, not 318: the rail is inset from the screen edge now, and the 16px it gives up is
    // the gap the wallpaper shows through. The desktop still reserves 318 for the column, so
    // nothing else has to know that this moved.
    width: 302px;
    // The same rule as the left column: the card is as tall as what it holds. It ran to the
    // taskbar, so a machine with six services showed a hundred pixels of empty panel under
    // "Suggestions 0" -- and the wallpaper it was covering was better than it was.
    // Not `max-height`: that is a built-in Slint property and means something else -- a
    // constraint a layout may honour, which this rail is not inside.
    in property <length> height-ceiling: 100000px;
    height: Math.min(rail-body.preferred-height, root.height-ceiling);
    border-radius: Theme.r-lg;
    background: Theme.glass-rail;
    border-width: 1px;
    border-color: Theme.glass-border;
    clip: true;

    rail-body := VerticalLayout {
        padding: Theme.sp-4;
        spacing: 0;

        SectionLabel { text: "LOAD"; }
        Rectangle { height: 9px; }
        Meter { name: "CPU";    value-text: root.cpu-percent + "%"; percent: root.cpu-percent;
                tone: root.cpu-percent >= 90 ? Theme.color-warning : Theme.accent; }
        Meter { name: "Memory"; value-text: root.mem-text;  percent: root.mem-percent;
                tone: root.mem-percent >= 90 ? Theme.color-warning : Theme.accent; }
        Meter { name: "Swap";   value-text: root.swap-text; percent: root.swap-percent;
                tone: root.swap-percent > 0 ? Theme.color-warning : Theme.color-success; }
        Meter { name: "Disk";   value-text: root.disk-text; percent: root.disk-percent;
                tone: root.disk-percent >= 90 ? Theme.color-danger : Theme.text-secondary; }

        Rectangle { height: 1px; background: Theme.separator; }
        Rectangle { height: Theme.sp-3; }

        SectionLabel { text: "SERVICES"; }
        Rectangle { height: 6px; }
        if root.services.length == 0 : Text {
            text: "No services registered.";
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
        }
        for s in root.services : HorizontalLayout {
            height: 24px;
            spacing: 9px;
            Rectangle {
                width: 6px; height: 6px;
                y: (parent.height - 6px) / 2;
                border-radius: 3px;
                background: s.status == "running"  ? Theme.color-success
                          : s.status == "starting" ? Theme.color-warning
                          : s.status == "failed"   ? Theme.color-danger
                          : Theme.text-dim;
            }
            Text {
                text: s.id;
                color: s.status == "stopped" ? Theme.text-secondary : Theme.text-primary;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: s.note;
                color: s.status == "failed" ? Theme.color-danger : Theme.text-dim;
                font-size: Theme.fs-micro;
                vertical-alignment: center;
                overflow: elide;
                max-width: 110px;
            }
        }

        Rectangle { height: Theme.sp-3; }
        Rectangle { height: 1px; background: Theme.separator; }
        Rectangle { height: Theme.sp-3; }

        SectionLabel { text: "COMPANION"; }
        Rectangle { height: 8px; }
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            KeyValue { key: "State";
                       value: !root.companion-online ? "offline" : root.companion-status;
                       value-color: !root.companion-online ? Theme.color-danger
                                  : root.companion-status == "thinking" ? Theme.accent
                                  : Theme.text-primary; }
            // An em-dash for "no model" reads as a fault rather than as a machine nobody has
            // configured yet, and it said nothing about WHICH mind is answering — which, now
            // that a harness can attach and take the conversation, is the more important half.
            KeyValue { key: "Mind";
                       value: root.mind-name != "" ? root.mind-name : "none attached"; }
            // Whichever mind is ANSWERING, not whichever model this shell was configured with.
            // They are the same thing only while the built-in is driving; with a harness attached
            // this row read "qwen3.5:9b" — the shell's setting — while every word was being
            // answered somewhere else entirely, on a different model. A status line that reports
            // the configuration of something that is not doing the work is worse than no line.
            KeyValue { key: "Model";
                       value: root.mind-detail != "" ? root.mind-detail
                            : root.provider-label != "" ? root.provider-label
                            : "not configured";
                       value-color: (root.mind-detail != "" || root.provider-label != "")
                            ? Theme.text-primary : Theme.text-dim; }
            // "—" until the store has been read once, never the property's default as a level.
            KeyValue { key: "Bond";
                       value: root.bond-loaded
                            ? root.bond-level + " · " + Math.round(root.bond-score * 100) + "%"
                            : "—";
                       value-color: root.bond-loaded ? Theme.text-primary : Theme.text-dim; }
            KeyValue { key: "Memories"; value: "" + root.memory-count; }
            KeyValue { key: "Suggestions"; value: "" + root.whisper-count;
                       value-color: root.whisper-count > 0 ? Theme.accent : Theme.text-primary; }
        }

    }
}
