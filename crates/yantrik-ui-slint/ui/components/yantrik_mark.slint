// ═══════════════════════════════════════════════════════════════════════════════════════
// yantrik_mark.slint — the product's face
// ═══════════════════════════════════════════════════════════════════════════════════════
//
// A dark sphere with a lit rim, carrying a Y.
//
// # Why this is not the orb
//
// The boot screen used Orb, which is the COMPANION's orb: on the desktop it pulses when the
// mind is thinking, brightens when it is speaking, and carries a ring when it has something to
// say. It is a status indicator, and a good one.
//
// Using it as the product mark makes the brand a status indicator too. The thing that means
// "this is Yantrik OS" has to be the same every time it is seen — boot screen, About box, disk
// image — while the thing that means "the companion is listening" has to change. One shape
// cannot do both jobs, and when it tries the constant one loses: a logo that animates is not a
// logo, it is a widget.
//
// # How the rim is made, and why it is made that way
//
// The obvious build is one circle with a teal-to-violet gradient. It does not work here: this
// renderer does not clip a GRADIENT to a border radius, so that produces a teal-to-violet
// SQUARE with a circular rim drawn inside it. Moving the gradient onto a child and putting
// `clip: true` on the rounded parent does not help either — both were tried, both kept the
// square. Solid fills DO respect the radius, which the glass cards on the desktop have been
// quietly proving all along.
//
// So the rim is made by subtraction. Two bright discs, one teal and one violet offset against
// it, then a dark disc over the middle. What is left uncovered is a ring that is teal on one
// shoulder and violet on the other — which is the picture — and every shape in it is a plain
// rounded rectangle the renderer is willing to draw round.
//
// # The shape
//
// Three strokes meeting off-centre: two arms up, one stem down. The letter, and also a junction
// — three paths converging, which is the argument of this OS drawn in one glyph.

import { Theme } from "theme.slint";

export component YantrikMark inherits Rectangle {
    in property <length> mark-size: 128px;

    width: root.mark-size;
    height: root.mark-size;

    // ── The lit rim, by subtraction ──
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: self.width / 2;
        background: #2fd4c4;
    }
    Rectangle {
        width: parent.width * 0.98;
        height: parent.height * 0.98;
        x: parent.width * 0.02;
        y: parent.height * 0.02;
        border-radius: self.width / 2;
        background: #8b5cf6;
    }
    // Covering most of it back up. What survives is the ring.
    Rectangle {
        width: parent.width * 0.94;
        height: parent.height * 0.94;
        x: parent.width * 0.03;
        y: parent.height * 0.03;
        border-radius: self.width / 2;
        background: #0d1420;
    }

    // ── Inside the glass ──
    //
    // Barely there. A sphere this dark needs one hint that it is round and not a hole; the rim
    // does most of that work and this is the rest of it.
    Rectangle {
        width: parent.width * 0.62;
        height: parent.height * 0.62;
        x: parent.width * 0.10;
        y: parent.height * 0.08;
        border-radius: self.width / 2;
        background: #2fd4c40c;
    }
    Rectangle {
        width: parent.width * 0.44;
        height: parent.height * 0.44;
        x: parent.width * 0.46;
        y: parent.height * 0.50;
        border-radius: self.width / 2;
        background: #8b5cf60c;
    }

    // ── The Y ──
    //
    // Drawn rather than typeset. A font would make the mark depend on which typeface a machine
    // happened to have, and the one thing a logo cannot do is vary.
    Path {
        x: parent.width * 0.29;
        y: parent.height * 0.28;
        width: parent.width * 0.42;
        height: parent.height * 0.44;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: #2fd4c4;
        stroke-width: 3.2px;
        commands: "M 1 1 L 10 9";
    }
    Path {
        x: parent.width * 0.29;
        y: parent.height * 0.28;
        width: parent.width * 0.42;
        height: parent.height * 0.44;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: #5eb8ff;
        stroke-width: 3.2px;
        commands: "M 19 1 L 10 9";
    }
    Path {
        x: parent.width * 0.29;
        y: parent.height * 0.28;
        width: parent.width * 0.42;
        height: parent.height * 0.44;
        viewbox-width: 20;
        viewbox-height: 20;
        stroke: #3fc9ea;
        stroke-width: 3.2px;
        commands: "M 10 9 L 10 19";
    }
}
