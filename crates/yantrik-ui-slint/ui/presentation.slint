// Presentation App (yPresent) — screen 31
// Slide deck editor with layouts, themes, speaker notes, a presenter mode with a timer,
// save and load over a versioned .ydeck file, slide search, keyboard navigation, and export
// to Markdown and to an outline.
// Wrapped in WindowFrame by app.slint.
//
// What came off this screen on 20 September 2026, and why. Every one of these drew a control
// with nothing under it; a button that does nothing is worse than an absent one, because a
// person plans around it.
//
//   * Export PDF. Nothing in this dependency set writes a PDF, and a "PDF" that was really
//     text would be a lie about a file someone is about to send. It comes back when a PDF
//     writer is a dependency.
//   * The INSERT tab — text box, image, shape, chart, table, icon. SlideData holds a title,
//     a body, notes and a layout; there is nowhere for an object to live. It comes back with
//     a slide model that has objects in it.
//   * Bold, italic, font size and text colour. The body is one TextInput drawn in one colour
//     at one size from the theme; there are no runs to mark up. It comes back with a styled
//     text model.
//   * Transitions. Nothing here animates between slides, so the dropdown named an effect that
//     could not happen. It comes back when the presenter view animates.
//   * The five quick "templates" (Blank, Status, Proposal, Team, Quarterly). Nothing backed
//     them: five named deck outlines would have been text this app invented. It comes back
//     with a template directory a person can put their own decks in. The Gallery beside it
//     stays, because it really does the one thing it claims — it picks a theme.
//   * The speaker-notes ribbon toggle and pres-save-speaker-note. The toggle gated nothing at
//     all, and the callback was invoked by no element in this file; the notes editor is
//     always on screen below the canvas and its text is two-way bound to current-notes.
//   * The whole AI Assist panel and its thirteen callbacks. It is built around a proposal
//     architecture — AiProposalState, a per-field apply, a deck-wide preview — that nothing
//     produced, and wiring thirteen buttons to one companion call would have been thirteen
//     ways to overwrite a deck with model text and no way to review it. The one place a
//     generated answer has somewhere to land is the speaker-note field, and that button
//     (AI Generate, in the notes header) is real.

import { Theme } from "theme.slint";
import { ListView, ScrollView, LineEdit } from "std-widgets.slint";
import { RibbonToolButton, RibbonToolButtonWide, RibbonSeparator, RibbonTabButton,
         RibbonGroupLabel, RibbonDropdown } from "components/app_ribbon.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";

// A slide as the sidebar and the canvas read it.
//
// `slide-number` used to be here and was kept in step by a `renumber()` pass after every
// reorder and removal — a second source of truth for a thing that is already a position in a
// list. The sidebar numbers its own rows from the index; there is nothing to fall out of step.
export struct SlideData {
    title: string,
    body: string,
    notes: string,
    layout: int,
}

export struct PresentTheme {
    name: string,
    bg-color: brush,
    text-color: brush,
    accent-color: brush,
    is-active: bool,
}

export component PresentationScreen inherits Rectangle {
    background: transparent;

    // Slide data
    in property <[SlideData]> slides: [];
    in-out property <int> current-slide-index: 0;
    in property <int> slide-count: 1;
    in-out property <int> current-layout: 0;
    // The chosen theme, as a one-element list.
    //
    // This screen reads `themes[0]` and only `themes[0]` — canvas, presenter view and
    // thumbnails all do — so the app hands it the theme that is selected rather than a list to
    // choose from. Nothing ever set it, which is why every slide in the app was drawn in the
    // shell's fallback colours and the Design tab's Theme dropdown was decorative.
    in property <[PresentTheme]> themes: [];
    /// Which theme that is, so the dropdown can count upwards. Rust wraps.
    in property <int> current-theme: 0;
    in-out property <bool> is-presenting: false;
    in-out property <string> current-title: "Title Slide";
    in-out property <string> current-body: "Click to add subtitle";
    in-out property <string> current-notes: "";

    // New properties
    in property <string> timer-text: "00:00";
    in property <string> next-title: "";
    in property <string> next-body: "";
    in property <string> presentation-title: "";
    in property <string> slide-progress: "Slide 1 of 1";
    in property <string> file-path: "";
    in property <bool> is-modified: false;
    in property <string> save-status: "";
    in property <int> search-count: 0;
    in-out property <string> search-query: "";
    in-out property <bool> show-search: false;

    /// What the window could not do, in the person's words.
    ///
    /// Empty when nothing has gone wrong, which is also the default — the same string is in
    /// `describe.notice`, so a failure is said twice: once to whoever is looking at the
    /// window and once to whoever is driving it. A save that could not be written, a file
    /// that is a version this build does not read, a companion that did not answer.
    in property <string> notice: "";

    // Theme gallery. Every theme Rust holds, each drawn in its own colours, with `is-active`
    // on the one the deck is using — rather than a list of names beside a hardcoded palette.
    in-out property <bool> pres-template-gallery-open: false;
    in property <[PresentTheme]> theme-swatches: [];

    // Layout names for display
    property <[string]> layout-names: ["Title Slide", "Title + Content", "Two Column", "Section Header", "Blank", "Image + Text"];

    // Callbacks — existing
    callback add-slide();
    callback delete-slide();
    callback duplicate-slide();
    callback move-slide-up();
    callback move-slide-down();
    callback select-slide(int);
    callback set-layout(int);
    callback set-theme(int);
    callback toggle-present();
    callback title-edited(string);
    callback body-edited(string);
    callback notes-edited(string);
    callback next-slide();
    callback prev-slide();

    // Callbacks — new
    callback save-presentation();
    callback load-presentation();
    callback toggle-timer();
    callback reset-timer();
    /// One key press, named rather than spelled.
    ///
    /// Slint puts the arrows and the page keys in the private-use area, and a Rust `match` on
    /// "\u{f702}" is unreadable and ungreppable. The translation happens once, in the focus
    /// scope at the bottom of this file, and the app handles "next", "previous", "first",
    /// "last" and "escape" — each of which ends in the same `go_to` the buttons use.
    callback key-pressed(string);
    callback export-markdown();
    callback export-outline();
    callback search-slides(string);
    callback search-next();
    callback undo();
    callback redo();
    /// Ask the companion for speaker notes for the slide on screen.
    callback generate-notes();

    // Theme gallery callbacks
    callback pres-open-template-gallery();
    callback pres-select-template(int);

    // ══════════════════════════════════════════
    // Presenter mode: full-screen slide view
    // ══════════════════════════════════════════
    Rectangle {
        visible: root.is-presenting;
        width: 100%;
        height: 100%;
        background: themes.length > 0 ? themes[0].bg-color : Theme.bg-card;

        property <brush> slide-bg: themes.length > 0 ? themes[0].bg-color : Theme.bg-card;
        property <brush> slide-text: themes.length > 0 ? themes[0].text-color : Theme.text-primary;
        property <brush> slide-accent: themes.length > 0 ? themes[0].accent-color : Theme.accent;

        // Main slide area (top 70%)
        Rectangle {
            width: 100%;
            height: parent.height * 0.70;

            // 16:9 slide centered
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 40px, (parent.height - 20px) * 16 / 9);
                height: self.width * 9 / 16;
                background: slide-bg;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-subtle;

                // Title
                Text {
                    x: 40px;
                    y: current-layout == 0 || current-layout == 3 ? parent.height * 0.35 : 30px;
                    width: parent.width - 80px;
                    text: current-title;
                    color: slide-text;
                    font-size: current-layout == 0 || current-layout == 3 ? 36px : 28px;
                    font-weight: 700;
                    horizontal-alignment: current-layout == 0 || current-layout == 3 ? center : left;
                    overflow: elide;
                }

                // Body
                Text {
                    x: 40px;
                    y: current-layout == 0 || current-layout == 3 ? parent.height * 0.55 : 80px;
                    width: current-layout == 2 ? parent.width / 2 - 60px : parent.width - 80px;
                    height: parent.height - (current-layout == 0 || current-layout == 3 ? parent.height * 0.55 : 80px) - 20px;
                    text: current-body;
                    color: slide-text;
                    font-size: current-layout == 0 ? 18px : 16px;
                    horizontal-alignment: current-layout == 0 || current-layout == 3 ? center : left;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            // Left/right click navigation
            TouchArea {
                width: parent.width / 2;
                height: parent.height;
                clicked => { root.prev-slide(); }
            }
            TouchArea {
                x: parent.width / 2;
                width: parent.width / 2;
                height: parent.height;
                clicked => { root.next-slide(); }
            }
        }

        // Presenter bottom panel (30% — notes + next slide + controls)
        Rectangle {
            y: parent.height * 0.70;
            width: 100%;
            height: parent.height * 0.30;
            background: Theme.bg-surface;

            // Top border
            Rectangle { height: 1px; background: Theme.border-subtle; }

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                // Speaker notes
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;

                        Text {
                            text: "Speaker Notes";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-micro;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                        }

                        ScrollView {
                            Text {
                                text: root.current-notes != "" ? root.current-notes : "(No notes for this slide)";
                                color: root.current-notes != "" ? Theme.text-primary : Theme.text-dim;
                                font-size: Theme.fs-body;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // Next slide preview + controls
                Rectangle {
                    width: 280px;

                    VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: "Next Slide";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                        }

                        // Mini next slide preview
                        Rectangle {
                            height: 80px;
                            background: slide-bg;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;

                                Text {
                                    text: root.next-title;
                                    color: slide-text;
                                    font-size: Theme.fs-micro;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: root.next-body;
                                    color: slide-text;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                    wrap: word-wrap;
                                    opacity: 0.7;
                                }
                            }
                        }

                        // Timer
                        Rectangle {
                            height: 36px;
                            background: Theme.bg-card;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;

                                Text {
                                    text: root.timer-text;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-display;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }

                                Rectangle {}

                                // Play/Pause timer
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: timer-ta.has-hover ? Theme.hover-fill : transparent;

                                    timer-ta := TouchArea { clicked => { root.toggle-timer(); } }
                                    Icon { commands: Icons.play; tint: Theme.text-secondary; size: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }

                                // Reset timer
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: reset-ta.has-hover ? Theme.hover-fill : transparent;

                                    reset-ta := TouchArea { clicked => { root.reset-timer(); } }
                                    Icon { commands: Icons.rotate-ccw; tint: Theme.text-secondary; size: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }
                            }
                        }

                        // Slide counter
                        Text {
                            text: root.slide-progress;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-body;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }

        // Exit button (top-right)
        Rectangle {
            x: parent.width - 120px;
            y: 10px;
            width: 100px;
            height: 36px;
            background: Theme.overlay-backdrop;
            border-radius: Theme.r-sm;

            Text {
                text: "Exit (Esc)";
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea { clicked => { root.toggle-present(); } }
        }
    }

    // ══════════════════════════════════════════
    // Normal edit mode
    // ══════════════════════════════════════════
    Rectangle {
        visible: !root.is-presenting;
        width: 100%;
        height: 100%;

        // Ribbon tab state: 0=Slides, 1=Design, 2=Insert, 3=Export
        property <int> ribbon-tab: 0;

        VerticalLayout {
            // -- Header --
            //
            // Above the ribbon, not instead of it: Slides/Design/Insert/Export are a ribbon and
            // belong in one. The deck's name, whether it is saved, and the verbs that apply to
            // the whole file belong in the frame every app wears.
            AppHeader {
                app-id: "presentation";
                icon: Icons.present;
                title: root.presentation-title != "" ? root.presentation-title : "yPresent";
                subtitle: root.slide-progress;
                modified: root.is-modified;
                status: root.save-status;
                leading-actions: [
                    { id: "save", icon: Icons.save, label: "Save", emphasis: 2, active: root.is-modified },
                    { id: "undo", icon: Icons.rotate-ccw },
                    { id: "redo", icon: Icons.rotate-cw },
                ];
                actions: [
                    { id: "find",    icon: Icons.search, label: "Find", active: root.show-search },
                    { id: "present", icon: Icons.play,   label: "Present", emphasis: 2 },
                ];
                action(id) => {
                    if (id == "save") { root.save-presentation(); }
                    else if (id == "undo") { root.undo(); }
                    else if (id == "redo") { root.redo(); }
                    else if (id == "find") { root.show-search = !root.show-search; }
                    else if (id == "present") { root.toggle-present(); }
                }
            }

            // ── Notice ──
            //
            // Under the header and above everything else, because it is always about why what
            // is below it is not what was asked for: a save that could not be written, a deck
            // this build will not open, a companion that did not answer.
            if root.notice != "" : Rectangle {
                height: notice-text.preferred-height + Theme.sp-4;
                background: Theme.color-danger-dim;

                Rectangle {
                    x: 0;
                    width: 2px;
                    height: 100%;
                    background: Theme.color-danger;
                }

                notice-text := Text {
                    x: Theme.sp-4;
                    width: parent.width - Theme.sp-4 * 2;
                    y: Theme.sp-2;
                    text: root.notice;
                    color: Theme.text-primary;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                }
            }
            // ═══ Row 1: Tab strip + Quick Actions (36px) ═══
            Rectangle {
                height: 36px;
                background: Theme.bg-surface;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 0px;

                    // The ribbon's tab strip, and nothing else.
                    //
                    // It used to open with Save / Undo / Redo and close with Find and AI -- all five of which
                    // are already in the AppHeader one row above, doing the same thing to the same document.
                    // Converting this app to the SDK header gave it the commands and left the old row intact,
                    // so the window opened with two command bars stacked, the top one and the bottom one
                    // offering the same five buttons eighteen pixels apart. The tabs are the part that was
                    // never anywhere else.

                    Rectangle { width: 12px; }

                    // Tab strip
                    RibbonTabButton { label: "Slides"; is-active: ribbon-tab == 0; clicked => { ribbon-tab = 0; } }
                    RibbonTabButton { label: "Design"; is-active: ribbon-tab == 1; clicked => { ribbon-tab = 1; } }
                    RibbonTabButton { label: "Export"; is-active: ribbon-tab == 2; clicked => { ribbon-tab = 2; } }

                    Rectangle {}
                }

                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
            }

            // ═══ Row 2: Grouped command band (44px) ═══
            Rectangle {
                height: 44px;
                background: Theme.bg-card;

                // ── SLIDES tab: Slide management ──
                if ribbon-tab == 0 : HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 3px;
                    alignment: start;

                    RibbonGroupLabel { label: "SLIDE"; }
                    RibbonToolButtonWide { label: "Slide"; icon-path: Icons.plus; tooltip-text: "Add slide"; clicked => { root.add-slide(); } }
                    RibbonToolButton { icon-path: Icons.copy; tooltip-text: "Duplicate"; clicked => { root.duplicate-slide(); } }
                    RibbonToolButton { icon-path: Icons.trash; tooltip-text: "Delete"; clicked => { root.delete-slide(); } }
                    RibbonToolButton { icon-path: Icons.arrow-up; tooltip-text: "Move up"; clicked => { root.move-slide-up(); } }
                    RibbonToolButton { icon-path: Icons.arrow-down; tooltip-text: "Move down"; clicked => { root.move-slide-down(); } }
                }

                // ── DESIGN tab: Layout + Theme ──
                if ribbon-tab == 1 : HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 3px;
                    alignment: start;

                    RibbonGroupLabel { label: "LAYOUT"; }
                    RibbonDropdown {
                        label: "";
                        value: root.current-layout == 0 ? "Title"
                            : root.current-layout == 1 ? "Content"
                            : root.current-layout == 2 ? "Two Col"
                            : root.current-layout == 3 ? "Section"
                            : root.current-layout == 4 ? "Blank"
                            : "Img+Text";
                        tooltip-text: "Slide layout";
                        clicked => { root.set-layout(mod(root.current-layout + 1, 6)); }
                    }

                    RibbonSeparator {}

                    // The dropdown says which theme is on and steps to the next one; Rust owns
                    // the list and the wrap, so this file never has to know how many there are.
                    RibbonGroupLabel { label: "THEME"; }
                    RibbonDropdown {
                        label: "";
                        value: root.themes.length > 0 ? root.themes[0].name : "Theme";
                        tooltip-text: "Slide theme";
                        clicked => { root.set-theme(root.current-theme + 1); }
                    }

                    RibbonSeparator {}

                    RibbonGroupLabel { label: "THEMES"; }
                    RibbonToolButtonWide {
                        label: "Gallery";
                        is-active: root.pres-template-gallery-open;
                        tooltip-text: "Pick a theme";
                        clicked => { root.pres-open-template-gallery(); }
                    }
                }

                // ── EXPORT tab: File + Export ──
                if ribbon-tab == 2 : HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 3px;
                    alignment: start;

                    RibbonGroupLabel { label: "FILE"; }
                    RibbonToolButtonWide { label: "Open"; tooltip-text: "Open the most recent deck"; clicked => { root.load-presentation(); } }

                    RibbonSeparator {}

                    RibbonGroupLabel { label: "EXPORT"; }
                    RibbonToolButtonWide { label: "MD"; tooltip-text: "Export Markdown"; clicked => { root.export-markdown(); } }
                    RibbonToolButtonWide { label: "Outline"; tooltip-text: "Export outline"; clicked => { root.export-outline(); } }
                }

                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
            }

            // ── Search bar ──
            Rectangle {
                height: root.show-search ? 34px : 0px;
                visible: root.show-search;
                background: Theme.bg-card;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;

                    Text { text: "Search:"; color: Theme.text-primary; font-size: Theme.fs-caption; font-weight: 500; vertical-alignment: center; }

                    search-input := LineEdit {
                        width: 200px;
                        text <=> root.search-query;
                        placeholder-text: "Search slides...";
                        accepted => { root.search-slides(root.search-query); }
                    }

                    RibbonToolButton { label: "↓"; tooltip-text: "Next result"; clicked => { root.search-next(); } }

                    Text {
                        text: root.search-count > 0 ? root.search-count + " found" : "";
                        color: Theme.text-dim;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                    }
                }

                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
            }

            // ── Main area: sidebar + editor + notes ──
            HorizontalLayout {
                // ── Slide sidebar ──
                Rectangle {
                    width: 200px;
                    background: Theme.bg-deep;
                    border-width: 0px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 0px;

                        // Header row
                        HorizontalLayout {
                            height: 28px;
                            spacing: 6px;

                            Text {
                                text: "SLIDES";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-micro;
                                font-weight: 700;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }

                            Rectangle {}

                            Text {
                                text: root.slide-count + "";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                vertical-alignment: center;
                            }
                        }

                        ListView {
                            for slide[idx] in root.slides : Rectangle {
                                height: 116px;
                                background: transparent;

                                VerticalLayout {
                                    padding-top: 5px;
                                    padding-bottom: 5px;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    spacing: 3px;

                                    // Slide number badge
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 4px;

                                        Rectangle {
                                            width: 22px;
                                            height: 16px;
                                            border-radius: 4px;
                                            background: idx == root.current-slide-index ? AppIdentity.accent.transparentize(0.7) : transparent;

                                            Text {
                                                text: "" + (idx + 1);
                                                color: idx == root.current-slide-index ? AppIdentity.accent : Theme.text-dim;
                                                font-size: Theme.fs-micro;
                                                font-weight: idx == root.current-slide-index ? 700 : 400;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {}
                                    }

                                    // Thumbnail card
                                    Rectangle {
                                        height: 88px;
                                        background: idx == root.current-slide-index ? Theme.bg-elevated : Theme.bg-surface;
                                        border-radius: 6px;
                                        border-width: idx == root.current-slide-index ? 2px : 1px;
                                        border-color: idx == root.current-slide-index ? AppIdentity.accent : Theme.border-subtle;
                                        opacity: idx == root.current-slide-index ? 1.0 : 0.75;

                                        // Active slide glow
                                        Rectangle {
                                            visible: idx == root.current-slide-index;
                                            width: 100%;
                                            height: 100%;
                                            border-radius: 6px;
                                            background: Theme.accent.transparentize(0.92);
                                        }

                                        VerticalLayout {
                                            padding: 8px;
                                            spacing: 3px;

                                            Text {
                                                text: slide.title;
                                                color: idx == root.current-slide-index ? Theme.text-primary : Theme.text-secondary;
                                                font-size: Theme.fs-micro;
                                                font-weight: 600;
                                                overflow: elide;
                                            }

                                            Text {
                                                text: slide.body;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-micro;
                                                overflow: elide;
                                                wrap: word-wrap;
                                            }
                                        }

                                        TouchArea {
                                            clicked => { root.select-slide(idx); }
                                        }
                                    }
                                }
                            }
                        }

                        // Inline add-slide button at bottom of rail
                        Rectangle {
                            height: 36px;

                            Rectangle {
                                x: 6px;
                                y: 4px;
                                width: parent.width - 12px;
                                height: 28px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: add-rail-ta.has-hover ? AppIdentity.accent.transparentize(0.5) : Theme.border-subtle;
                                background: add-rail-ta.has-hover ? AppIdentity.accent.transparentize(0.9) : transparent;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: "+";
                                        color: add-rail-ta.has-hover ? AppIdentity.accent : Theme.text-dim;
                                        font-size: Theme.fs-body;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "Add Slide";
                                        color: add-rail-ta.has-hover ? Theme.text-primary : Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }
                                }

                                add-rail-ta := TouchArea { clicked => { root.add-slide(); } }
                            }
                        }
                    }
                }

                // Separator
                Rectangle { width: 1px; background: Theme.separator; }

                // ── Center: slide editor + notes ──
                VerticalLayout {
                    spacing: 0px;

                    // Slide editor area
                    Rectangle {
                        background: Theme.bg-deep;

                        Rectangle {
                            x: 24px;
                            y: 16px;
                            width: parent.width - 48px;
                            height: parent.height - 32px;

                            property <length> avail-w: self.width;
                            property <length> avail-h: self.height;
                            property <length> fit-w: min(avail-w, avail-h * 16 / 9);
                            property <length> fit-h: fit-w * 9 / 16;

                            // The actual slide
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: parent.fit-w;
                                height: parent.fit-h;
                                background: themes.length > 0 ? themes[0].bg-color : Theme.bg-card;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                property <brush> t-text: themes.length > 0 ? themes[0].text-color : Theme.text-primary;
                                property <brush> t-accent: themes.length > 0 ? themes[0].accent-color : Theme.accent;

                                // Accent bar for Title Slide and Section Header
                                Rectangle {
                                    visible: current-layout == 0 || current-layout == 3;
                                    x: parent.width * 0.3;
                                    y: current-layout == 0 ? parent.height * 0.48 : parent.height * 0.45;
                                    width: parent.width * 0.4;
                                    height: 3px;
                                    background: t-accent;
                                    border-radius: 1px;
                                }

                                // Title input
                                Rectangle {
                                    visible: current-layout != 4;
                                    x: current-layout == 0 || current-layout == 3 ? parent.width * 0.1 : 30px;
                                    y: current-layout == 0 || current-layout == 3 ? parent.height * 0.25 : 20px;
                                    width: current-layout == 0 || current-layout == 3 ? parent.width * 0.8 : parent.width - 60px;
                                    height: current-layout == 0 ? parent.height * 0.2 : 40px;
                                    clip: true;

                                    title-input := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.current-title;
                                        color: t-text;
                                        font-size: current-layout == 0 || current-layout == 3 ? 24px : 20px;
                                        font-weight: 700;
                                        horizontal-alignment: current-layout == 0 || current-layout == 3 ? center : left;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => { root.title-edited(self.text); }
                                        edited => { root.title-edited(self.text); }
                                    }
                                }

                                // Body input
                                Rectangle {
                                    visible: current-layout != 4;
                                    x: current-layout == 0 || current-layout == 3 ? parent.width * 0.15 : 30px;
                                    y: current-layout == 0 ? parent.height * 0.55 : current-layout == 3 ? parent.height * 0.52 : 70px;
                                    width: current-layout == 2 ? parent.width * 0.45 - 30px
                                         : current-layout == 5 ? parent.width * 0.55 - 30px
                                         : current-layout == 0 || current-layout == 3 ? parent.width * 0.7 : parent.width - 60px;
                                    height: current-layout == 0 || current-layout == 3 ? parent.height * 0.2 : parent.height - 90px;
                                    clip: true;

                                    body-input := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.current-body;
                                        color: t-text;
                                        font-size: current-layout == 0 ? 14px : 13px;
                                        horizontal-alignment: current-layout == 0 || current-layout == 3 ? center : left;
                                        vertical-alignment: top;
                                        single-line: false;
                                        wrap: word-wrap;
                                        edited => { root.body-edited(self.text); }
                                    }
                                }

                                // Two Column: right column placeholder
                                Rectangle {
                                    visible: current-layout == 2;
                                    x: parent.width * 0.52;
                                    y: 70px;
                                    width: parent.width * 0.45 - 30px;
                                    height: parent.height - 90px;
                                    background: Theme.hover-fill;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    Text {
                                        text: "Column 2\n(use body text)";
                                        color: t-text;
                                        font-size: Theme.fs-micro;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        opacity: 0.4;
                                    }
                                }

                                // Image + Text: image placeholder
                                Rectangle {
                                    visible: current-layout == 5;
                                    x: parent.width * 0.58;
                                    y: 70px;
                                    width: parent.width * 0.38;
                                    height: parent.height - 90px;
                                    background: Theme.hover-fill;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;

                                        Icon {
                                            commands: Icons.image;
                                            tint: Theme.text-dim;
                                            size: 28px;
                                            opacity: 0.5;
                                        }
                                        Text {
                                            text: "Image placeholder";
                                            color: t-text;
                                            font-size: Theme.fs-micro;
                                            horizontal-alignment: center;
                                            opacity: 0.3;
                                        }
                                    }
                                }

                                // Blank layout watermark
                                Rectangle {
                                    visible: current-layout == 4;
                                    width: 100%;
                                    height: 100%;

                                    Text {
                                        text: "Blank Slide";
                                        color: t-text;
                                        font-size: Theme.fs-body;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        opacity: 0.15;
                                    }
                                }
                            }
                        }
                    }

                    // Separator
                    Rectangle { height: 1px; background: Theme.separator; }

                    // ── Speaker notes + slide info ──
                    Rectangle {
                        height: 130px;
                        background: Theme.bg-surface;

                        // Top separator with accent hint
                        Rectangle {
                            height: 1px;
                            background: Theme.separator;
                        }

                        VerticalLayout {
                            padding: 0px;
                            spacing: 0px;

                            // Notes header bar
                            Rectangle {
                                height: 30px;
                                background: Theme.bg-card;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;

                                    Text {
                                        text: "Speaker Notes";
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-micro;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Rectangle {}

                                    // Auto-generate notes button
                                    Rectangle {
                                        width: 76px;
                                        height: 22px;
                                        border-radius: 4px;
                                        background: gen-ta.has-hover ? AppIdentity.accent.transparentize(0.8) : transparent;
                                        border-width: 1px;
                                        border-color: Theme.accent.transparentize(0.6);

                                        gen-ta := TouchArea { clicked => { root.generate-notes(); } }

                                        Text {
                                            text: "AI Generate";
                                            font-size: Theme.fs-micro;
                                            color: Theme.accent;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Slide info inline
                                    RibbonSeparator {}

                                    Text {
                                        text: root.slide-progress;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: current-layout == 0 ? "Title Slide"
                                            : current-layout == 1 ? "Title + Content"
                                            : current-layout == 2 ? "Two Column"
                                            : current-layout == 3 ? "Section Header"
                                            : current-layout == 4 ? "Blank"
                                            : "Image + Text";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }

                                    // Modified indicator
                                    Rectangle {
                                        visible: root.is-modified;
                                        width: 64px;
                                        height: 18px;
                                        border-radius: 4px;
                                        background: Theme.amber-dim;

                                        Text {
                                            text: "Modified";
                                            color: Theme.amber;
                                            font-size: Theme.fs-micro;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        visible: root.save-status != "";
                                        text: root.save-status;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    // Where this deck lives.
                                    //
                                    // file-path was declared here and drawn by nothing, so a
                                    // deck saved into ~/Documents/Presentations was saved
                                    // somewhere the person had no way to find. Save always
                                    // picks a destination; this is how they learn which one.
                                    Text {
                                        visible: root.file-path != "";
                                        text: root.file-path;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Notes input area
                            Rectangle {
                                background: Theme.bg-deep; clip: true;
                                border-width: 0px;

                                notes-input := TextInput {
                                    x: 12px;
                                    y: 6px;
                                    width: parent.width - 24px;
                                    height: parent.height - 12px;
                                    text <=> root.current-notes;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    single-line: false;
                                    wrap: word-wrap;
                                    vertical-alignment: top;
                                    edited => { root.notes-edited(self.text); }
                                }

                                // Placeholder when empty
                                Text {
                                    visible: root.current-notes == "";
                                    x: 12px;
                                    y: 6px;
                                    text: "Add speaker notes for this slide...";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Template gallery overlay ──
    Rectangle {
        visible: root.pres-template-gallery-open;
        width: 100%;
        height: 100%;
        background: Theme.overlay-backdrop;

        // Backdrop click to close
        TouchArea {
            clicked => { root.pres-template-gallery-open = false; }
        }

        // Gallery card
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 300px;
            background: Theme.bg-elevated;
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border-subtle;

            // Prevent backdrop click from passing through
            TouchArea {}

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Themes";
                    color: Theme.accent;
                    font-size: Theme.fs-title-2;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Pick a theme. It is kept with the deck.";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-micro;
                    horizontal-alignment: center;
                }

                // Template grid
                Rectangle {
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        alignment: center;

                        // The swatch is the theme.
                        //
                        // It used to be five hardcoded colours picked by position out of the
                        // shell's own palette, so a card labelled "Creative" previewed a
                        // colour the deck would never be drawn in. A swatch that is not the
                        // thing it selects is the same lie as a reading nobody measured, in a
                        // smaller place.
                        for swatch[idx] in root.theme-swatches: Rectangle {
                            width: 70px;
                            height: 90px;
                            border-radius: 8px;
                            background: tpl-ta.has-hover ? AppIdentity.accent.transparentize(0.7) : Theme.hover-fill;
                            border-width: swatch.is-active ? 2px : 1px;
                            border-color: swatch.is-active ? AppIdentity.accent
                                : tpl-ta.has-hover ? AppIdentity.accent.transparentize(0.4)
                                : Theme.border-subtle;

                            tpl-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pres-select-template(idx);
                                    root.pres-template-gallery-open = false;
                                }
                            }

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                alignment: center;

                                Rectangle {
                                    width: 40px;
                                    height: 28px;
                                    border-radius: 4px;
                                    background: swatch.bg-color;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    Rectangle {
                                        x: 4px;
                                        y: parent.height - 6px;
                                        width: 14px;
                                        height: 2px;
                                        background: swatch.accent-color;
                                    }

                                    Text {
                                        text: "Aa";
                                        color: swatch.text-color;
                                        font-size: Theme.fs-caption;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: swatch.name;
                                    color: swatch.is-active ? AppIdentity.accent
                                        : tpl-ta.has-hover ? AppIdentity.accent : Theme.text-primary;
                                    font-size: Theme.fs-micro;
                                    font-weight: swatch.is-active ? 700 : 500;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Close button
                Rectangle {
                    height: 32px;

                    Rectangle {
                        width: 80px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        border-radius: 6px;
                        background: close-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;

                        close-ta := TouchArea { clicked => { root.pres-template-gallery-open = false; } }
                        Text { text: "Close"; color: Theme.text-secondary; font-size: Theme.fs-micro; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }

    // ── Keyboard ──
    //
    // This scope existed, was 0x0, and nothing ever focused it, so Present mode — the whole
    // point of the app — could only be driven with the mouse. It is focused on start and again
    // every time Present turns on, by the zero-sized `if` below: an `if` element is built when
    // its condition becomes true, so its `init` runs on every entry into Present and not only
    // once at startup.
    //
    // The navigation keys are gated on presenting, because in edit mode Space and the arrows
    // belong to whichever TextInput the person is typing into. Escape is not gated: it is how
    // you get out.
    //
    // Nothing is decided here. Each key is named and handed to the app, which routes all five
    // through the same `go_to` the buttons use — this scope used to call next-slide and
    // prev-slide itself, which made it a second navigation path to forget to fix.
    key-handler := FocusScope {
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if event.text == "\u{001b}" {
                root.key-pressed("escape");
                accept
            } else if root.is-presenting {
                if event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == " " || event.text == Key.PageDown {
                    root.key-pressed("next");
                    accept
                } else if event.text == Key.LeftArrow || event.text == Key.UpArrow || event.text == Key.PageUp {
                    root.key-pressed("previous");
                    accept
                } else if event.text == Key.Home { root.key-pressed("first"); accept }
                else if event.text == Key.End { root.key-pressed("last"); accept }
                else { reject }
            } else { reject }
        }
    }

    // Focus follows Present. Zero-sized and drawn nowhere; it exists for its `init`.
    if root.is-presenting : Rectangle {
        width: 0px;
        height: 0px;
        init => { key-handler.focus(); }
    }

    init => { key-handler.focus(); }
}
