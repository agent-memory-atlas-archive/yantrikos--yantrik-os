// Personality screen — radar chart + opinions + shared references.

import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";
import { RadarChart } from "components/radar_chart.slint";

export struct OpinionData {
    topic: string,
    stance: string,
    confidence: float,
}

export struct SharedRefData {
    text: string,
    times-used: int,
}

export component PersonalityScreen inherits Rectangle {
    in property <float> formality: 0.5;
    in property <float> humor-ratio: 0.5;
    in property <float> opinion-strength: 0.5;
    in property <float> question-ratio: 0.5;
    in property <[OpinionData]> opinions: [];
    in property <[SharedRefData]> shared-refs: [];
    callback back-pressed();

    background: Theme.bg-deep;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // Was a hand-rolled bar whose back button was the CHARACTER "left arrow" in a TouchArea.
        // A glyph is only an icon if the font has it; the same habit put an emoji in the Memory
        // browser's search field, where it drew as nothing and made the whole field look blank.
        // AppHeader's back button is a stroke path from the Icons set.
        AppHeader {
            app-id: "personality";
            show-back: true;
            icon: Icons.companion;
            title: "Personality";
            back => { root.back-pressed(); }
        }

        // Scrollable content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: start;

                // Radar chart, on a card like every other panel in this OS. It used to float
                // directly on the background, which made it read as a stray diagram rather
                // than a reading of something.
                Rectangle {
                    height: 260px;
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;

                HorizontalLayout {
                    alignment: center;
                    RadarChart {
                        formality: root.formality;
                        humor: root.humor-ratio;
                        opinion: root.opinion-strength;
                        question: root.question-ratio;
                        size-px: 200;
                    }
                }
                }

                // Opinions section
                Text {
                    text: "Opinions";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    letter-spacing: 1px;
                }

                for op[idx] in opinions : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: op-layout.preferred-height;

                    op-layout := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: op.topic;
                                color: Theme.amber-light;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Text {
                                text: op.stance;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                            }
                        }

                        // Confidence bar
                        Rectangle {
                            width: 40px;
                            height: 4px;
                            y: (parent.height - 4px) / 2;
                            border-radius: 2px;
                            background: Theme.bg-elevated;

                            Rectangle {
                                width: parent.width * op.confidence;
                                height: parent.height;
                                border-radius: 2px;
                                background: Theme.amber;
                            }
                        }
                    }
                }

                // Empty state for opinions
                //
                // Left-aligned, like the heading it belongs to. It was centred, so "Opinions"
                // sat at x=24 and the line explaining that there are none sat at x=640 -- a
                // heading and its content with six hundred pixels between them, reading as two
                // unrelated things.
                if opinions.length == 0 : Text {
                    text: "No opinions formed yet";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                }

                // Shared references section
                Text {
                    text: "Shared References";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    letter-spacing: 1px;
                }

                for sr[idx] in shared-refs : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: sr-layout.preferred-height;

                    sr-layout := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "\"" + sr.text + "\"";
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            font-italic: true;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: "×" + sr.times-used;
                            color: Theme.text-dim;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                }

                if shared-refs.length == 0 : Text {
                    text: "No shared references yet";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                }
            }
        }
    }
}
