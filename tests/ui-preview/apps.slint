// Production app components with deterministic sample data. No file-system writes.
import { Theme, ThemeMode } from "theme.slint";
import { NotesEditor } from "notes_editor.slint";
import { FileBrowser, FileEntry } from "file_browser.slint";
import { SettingsScreen } from "settings.slint";

export component AppsScene inherits Rectangle {
    in property <string> scene;
    callback action(string);
    in-out property <bool> notes-library: true;
    in-out property <bool> notes-assistant: false;
    in-out property <bool> overview: false;
    background: Theme.bg-deep;
    if root.scene == "notes" : NotesEditor {
        width: 100%; height: 100%;
        library-visible <=> root.notes-library;
        assistant-visible <=> root.notes-assistant;
        notes-list: [
            { title: "A little room to think", filename: "room.md", preview: "Good tools leave space for the work.", modified: "Today, 10:24", tags: "ideas", is-pinned: true },
            { title: "A weekend in the mountains", filename: "weekend.md", preview: "Pack light. Take the scenic route.", modified: "Yesterday", tags: "personal" },
            { title: "Project journal", filename: "journal.md", preview: "Small decisions that make a difference.", modified: "September 17", tags: "work" },
            { title: "Books worth returning to", filename: "books.md", preview: "A few pages at a time.", modified: "September 15" }
        ];
        import-md => { root.action("import"); }
        new-note => { root.action("new-note"); }
        save-note => { root.action("save-note"); }
        select-note(i) => { root.action("note-" + i); }
        selected-index: 0; current-title: "A little room to think";
        note-count: 4; folder-all-count: 4; folder-fav-count: 1; folder-recent-count: 3;
        agent-suggestions: [{ id: "summary", label: "Summarise this note", detail: "From the text in this note", icon: "template" }];
        current-tags: "ideas"; meta-word-count: 72;
        meta-created: "Sep 18"; meta-modified: "Today, 10:24";
        current-content: "Good tools leave space for the work.\n\nA place to collect the small things before they become something bigger: a thought on the train, an idea for a project, a sentence worth keeping.\n\nToday’s intentions\n\n• Make time for focused work\n• Leave a little room for curiosity\n• Finish one thing with care\n\nRelated: [[Project journal]]\n\nThe best part of a fresh page is that it can become anything.";
    }
    if root.scene == "files" || root.scene == "files-grid" || root.scene == "files-empty" : FileBrowser {
        width: 100%; height: 100%;
        current-path: "/home/yantrik/Documents";
        breadcrumbs: [{ label: "Home", full-path: "/home/yantrik" }, { label: "Documents", full-path: "/home/yantrik/Documents" }];
        grid-view: root.scene == "files-grid";
        can-go-back: true;
        go-back => { root.action("back"); }
        go-forward => { root.action("forward"); }
        navigate-dir(name) => { root.action("folder:" + name); }
        file-selection-changed(name) => { root.action("file:" + name); }
        multi-select-clicked(index, control, shift) => { self.selected-index = index; root.action("file:" + self.entries[index].name); }
        entries: root.scene == "files-empty" ? [] : self.sample-entries;
        property <[FileEntry]> sample-entries: [
            { name: "Projects", is-dir: true, modified-text: "Today, 09:42", item-count: 6, count-known: true, changed-text: "1 h ago" },
            { name: "Personal", is-dir: true, modified-text: "Yesterday", item-count: 14, count-known: true, changed-text: "1 d ago" },
            { name: "Reference", is-dir: true, modified-text: "Sep 17, 2026", count-known: false, count-reason: "permission denied", changed-text: "6 d ago" },
            { name: "Getting started.md", size-text: "2.4 KB", modified-text: "Today, 10:24", icon-char: "≡", changed-text: "12 min ago" },
            { name: "Project brief.pdf", size-text: "184 KB", modified-text: "Yesterday", icon-char: "▧", changed-text: "1 d ago" },
            { name: "Autumn landscape.png", size-text: "3.2 MB", modified-text: "Sep 17, 2026", icon-char: "▣", changed-text: "6 d ago" },
            { name: "Ideas for next week.txt", size-text: "1.1 KB", modified-text: "Sep 16, 2026", icon-char: "≡", changed-text: "7 d ago" },
            { name: "Budget.csv", size-text: "8.7 KB", modified-text: "Sep 15, 2026", icon-char: "◇", changed-text: "8 d ago" }
        ];
        free-space-text: "42.8 GB available";
    }
    // Files at home, as the redesign draws it: the places this home has, folder tiles with
    // their counts and times (one that could not be read), and the recent row under the grid.
    if root.scene == "files-home" || root.scene == "files-home-list" : FileBrowser {
        width: 100%; height: 100%;
        current-path: "~";
        breadcrumbs: [{ label: "Home", full-path: "~" }];
        grid-view: root.scene == "files-home";
        can-go-back: true;
        places: [
            { id: "home", label: "Home", path: "~" },
            { id: "documents", label: "Documents", path: "~/Documents" },
            { id: "downloads", label: "Downloads", path: "~/Downloads" },
            { id: "pictures", label: "Pictures", path: "~/Pictures" },
            { id: "music", label: "Music", path: "~/Music" },
            { id: "videos", label: "Videos", path: "~/Videos" },
            { id: "projects", label: "Projects", path: "~/Projects" }
        ];
        entries: [
            { name: "Documents", is-dir: true, item-count: 12, count-known: true, changed-text: "2 h ago" },
            { name: "Downloads", is-dir: true, item-count: 31, count-known: true, changed-text: "25 min ago" },
            { name: "Music", is-dir: true, item-count: 0, count-known: true, changed-text: "2 mo ago" },
            { name: "Pictures", is-dir: true, item-count: 148, count-known: true, changed-text: "3 d ago" },
            { name: "Projects", is-dir: true, item-count: 6, count-known: true, changed-text: "just now" },
            { name: "Shared", is-dir: true, count-known: false, count-reason: "permission denied", changed-text: "5 d ago" },
            { name: "Videos", is-dir: true, item-count: 1, count-known: true, changed-text: "1 y ago" },
            { name: "notes.md", size-text: "4.1 KB", icon-char: "≡", changed-text: "8 min ago" },
            { name: "budget.csv", size-text: "8.7 KB", icon-char: "◇", changed-text: "1 d ago" },
            { name: "landscape.png", size-text: "2.4 MB", icon-char: "▣", changed-text: "3 h ago" }
        ];
        recent: [
            { name: "notes.md", size-text: "4.1 KB", changed-text: "8 min ago", icon-char: "≡" },
            { name: "landscape.png", size-text: "2.4 MB", changed-text: "3 h ago", icon-char: "▣" },
            { name: "budget.csv", size-text: "8.7 KB", changed-text: "1 d ago", icon-char: "◇" }
        ];
        free-space-text: "42.8 GB available";
    }
    if root.scene == "settings" : SettingsScreen {
        width: 100%; height: 100%;
        agent-mode: root.overview;
        set-agent-mode(value) => { root.overview = value; root.action(value ? "overview" : "everyday"); }
        dark-mode: ThemeMode.dark;
        wallpaper-path: "serenity";
        toggle-dark-mode => { ThemeMode.dark = !ThemeMode.dark; root.action("theme"); }
        wallpaper-changed(id) => { root.action("wallpaper:" + id); }
    }
}
