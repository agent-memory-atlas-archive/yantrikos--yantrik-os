# Rust
target/
dist/

.brainstorm/

# SQLite databases (runtime)
memory.db
memory.db-shm
memory.db-wal
memory.db.bak

# MCP / Saga (runtime WAL/SHM)
.tracker.db-shm
.tracker.db-wal
.env

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Claude Code — local dev tooling, not the OS: session settings/permissions,
# handoff notes, and the MCP config (+ its placeholder template).
.claude/
.mcp.json
.mcp.json.template

# Scripts (local-only by default)
#
# Most of scripts/ is probes and one-off deploy helpers that mean nothing outside this machine.
# The exceptions are the two renderers that PRODUCE things the OS ships: the wallpapers are
# generated art, and a generated asset whose generator is not in the repo is a binary somebody
# exported once and nobody can ever change.
scripts/*
!scripts/render-wallpapers.py
!scripts/render-scene-wallpapers.py
!scripts/render-window-buttons.py

# Python
__pycache__/
unsloth_compiled_cache/

# Cargo local config
.cargo/

# VM backup
.vm-backup/

# Brainstorm / MCP tool outputs
brainstorm_*.md
mcp__brainstorm__*.txt

# Compiler long-type diagnostics
lib.long-type-*.txt

# Large binaries
*.iso
*.gguf
*.png
# ...except the ones the desktop is made of. These are the shell's wallpapers and its icon
# theme: without them a fresh clone builds an OS whose desktop has no picture on it, which is
# not a smaller version of this project, it is a broken one. They are 60-270 KB each and they
# are reproducible from the scripts above, so they belong in the tree next to them.
!crates/yantrik-ui-slint/ui/wallpapers/*.png
# ...and the titlebar buttons, for the same reason: generated, tiny, and the window has no
# close button without them.
!config/labwc/*.png

# Secrets
google_client_*
*.secret*

# Personal scripts (not part of the project)
create_*_epics.py
create_*_epic.py
migrate_*.py
reddit_post.png
skill_store_screenshot.png

# Test scripts (local-only)
test-*.sh
test_*.sh
test_*.py
# ...but not the unit tests that ship with a harness plugin.
!harnesses/*/tests/test_*.py

# Brainstorm outputs
brainstorm_*.py

# Training artifacts
training/checkpoints*/
training/model_*/
training/unsloth_compiled_cache/

# Deploy cache
deploy/yantrik-os/cache/

# Tracker DB
.tracker.db
jira.py
truenas

# Patent files (backed up on TrueNAS)
yantrikdb_patent*
patent_drawings*
patent_figures/

# Training (backed up on TrueNAS)
training/

# Misc local-only files
prompt_catalog.db
Cargo.companion.toml
Dockerfile.build
.dockerignore