// Yantrik Network Manager — standalone app window.
// Wraps the shared NetworkManager component in its own Window.

import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposal } from "components/agent_proposal.slint";
import { AppIdentity } from "app_color.slint";
import { NetworkManager, WifiNetwork, EthernetInterface,
         FirewallRule } from "network_manager.slint";

export { WifiNetwork, EthernetInterface, FirewallRule, ThemeMode, AccentPreset }
export { AgentContextItem, AgentSuggestion, AgentProposal }

export component NetworkManagerApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    // ── The agent layer ──
    in property <[AgentContextItem]> agent-context <=> net.agent-context;
    in property <[AgentSuggestion]> agent-suggestions <=> net.agent-suggestions;
    in property <string> agent-unavailable <=> net.agent-unavailable;
    callback agent-context-activated <=> net.agent-context-activated;
    callback agent-suggestion-activated <=> net.agent-suggestion-activated;
    in property <AgentProposal> proposal <=> net.proposal;
    in property <bool> proposal-working <=> net.proposal-working;
    callback proposal-applied <=> net.proposal-applied;
    callback proposal-dismissed <=> net.proposal-dismissed;
    
    // What app this window is.
    //
    // Set on the WINDOW and not on AppHeader, which is where it lived first: a header covers
    // the screens that have one, and Email's account-setup screen has none -- so the app that
    // most needs to look like itself on first run was the one screen still drawing the house
    // teal. The window is the only element every screen of an app is inside.
    init => { AppIdentity.id = "network"; }

    default-font-family: Theme.font-ui;
    title: "Network";
    // preferred-, not fixed: a fixed size makes the window unresizable, and the content
    // stays this size even when the compositor maximises or fullscreens the window.
    preferred-width: 1100px;
    preferred-height: 750px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg-deep;

    // ── Active tab ──
    in-out property <int> active-tab <=> net.active-tab;

    // ── What went wrong, for the person ──
    //
    // The same string the app's `describe` publishes as `notice`. Contract point 4: a failure is
    // said twice. This app had nowhere to say one at all — three of its five Wi-Fi calls went
    // into a `let _ =`, and the radio toggle logged that it had toggled whatever came back.
    in property <string> notice <=> net.notice;

    // ── Wi-Fi state ──
    //
    // `wifi-enabled` was here, aliased through to the screen and never written from Rust, so the
    // window drew "Wi-Fi: Off" on a machine with no Wi-Fi adapter in it. These three say which
    // of the three things is true, and each is set from a reading in main.rs.
    in property <bool> wifi-adapter-present <=> net.wifi-adapter-present;
    in property <string> wifi-radio <=> net.wifi-radio;
    in property <string> wifi-state-reason <=> net.wifi-state-reason;
    in property <string> wifi-current-ssid <=> net.wifi-current-ssid;
    in property <int> wifi-signal-strength <=> net.wifi-signal-strength;
    in property <string> wifi-ip-address <=> net.wifi-ip-address;
    in property <string> wifi-speed <=> net.wifi-speed;
    in property <[WifiNetwork]> wifi-networks <=> net.wifi-networks;
    in property <[WifiNetwork]> wifi-saved-networks <=> net.wifi-saved-networks;
    in property <bool> wifi-scanning <=> net.wifi-scanning;

    // ── WiFi password dialog ──
    in-out property <bool> wifi-password-visible <=> net.wifi-password-visible;
    in-out property <string> wifi-password-ssid <=> net.wifi-password-ssid;
    in-out property <string> wifi-password-input <=> net.wifi-password-input;
    in property <string> wifi-connect-status <=> net.wifi-connect-status;

    // ── Ethernet state ──
    in property <[EthernetInterface]> ethernet-interfaces <=> net.ethernet-interfaces;

    // ── Firewall state ──
    //
    // `firewall-enabled` was the other unset bool, and the screen drew it as "Off" in warning
    // colour. A word now, from a reading: "active", "inactive", "absent", "unknown" — with the
    // reason beside it whenever it is not a plain yes.
    in property <string> firewall-state <=> net.firewall-state;
    in property <string> firewall-backend-name <=> net.firewall-backend-name;
    in property <int> firewall-rule-count <=> net.firewall-rule-count;
    in property <[FirewallRule]> firewall-rules <=> net.firewall-rules;
    in property <string> firewall-reason <=> net.firewall-reason;

    // ── WiFi connection details ──
    in property <string> wifi-gateway <=> net.wifi-gateway;
    in property <string> wifi-dns <=> net.wifi-dns;
    in property <string> wifi-subnet <=> net.wifi-subnet;
    in-out property <bool> wifi-details-expanded <=> net.wifi-details-expanded;

    // ── Status bar ──
    in property <string> status-connection-type <=> net.status-connection-type;
    in property <string> status-ip-address <=> net.status-ip-address;
    in property <int> status-signal-strength <=> net.status-signal-strength;
    in property <string> status-state <=> net.status-state;

    // ── AI Assist ──
    in property <bool> ai-is-working <=> net.ai-is-working;
    in property <string> ai-response <=> net.ai-response;
    in-out property <bool> ai-panel-open <=> net.ai-panel-open;

    // ── Callbacks ──
    //
    // Five, and each has one path behind it in main.rs that the matching control-surface action
    // takes too. Eighteen more were here — Bluetooth, VPN, firewall writes, diagnostics, provider
    // connectivity — every one of them a log line on the Rust side.
    callback wifi-radio-set <=> net.wifi-radio-set;
    callback wifi-scan <=> net.wifi-scan;
    callback wifi-connect <=> net.wifi-connect;
    callback wifi-disconnect <=> net.wifi-disconnect;
    callback wifi-forget <=> net.wifi-forget;
    callback ai-explain-pressed <=> net.ai-explain-pressed;
    callback ai-dismiss <=> net.ai-dismiss;

    net := NetworkManager {
        window-bar: true;
        // Fills the window (no explicit size: Slint forbids width/height next to max-*).
        // The screen's own layouts may report a bounded maximum (a stretch layout of fixed rows);
        // the window must still open at its preferred size and grow with the user.
        max-width: 100000px;
        max-height: 100000px;
    }
}
