[Desktop Entry]
Type=Application
Name=Editor
Comment=Text and code editor with syntax highlighting
Exec=/opt/yantrik/bin/yantrik-text-editor
# One mark for now: brand/yantrik-mark.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Utility;TextEditor;
Keywords=text;editor;code;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=editor
X-Yantrik-Purpose=plain-text and code files, opened and saved by path
X-Yantrik-Aliases=text-editor
