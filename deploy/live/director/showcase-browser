#!/bin/sh
# The live instance's showcase window: a locked-down Chromium showing the Director's frame page
# (a caption bar over the game the Mind is building), beside Mind View on the stream. Started by
# `director.py showcase` (yantrik-live-showcase.service) under the person's Wayland session.
#
# The Director's window, never the Mind's. The Mind's own browser refuses file:// and new local
# addresses (check-page says why) and still does: this is not a browser the Mind can drive, and
# it opens one page, the frame, which the Director writes. The frame holds the Mind's own game,
# from ~/Projects, which the Mind's commands could already run as this same account; the
# showcase gives that code a screen and nothing else:
#   - no network: the unit has IPAddressDeny=any, every request goes to a proxy on a closed port
#     (127.0.0.1:9, loopback included), and every host name resolves to nothing;
#   - a throwaway profile, removed on exit: no cookies, history or storage outlive it, and the
#     person's profile is never read;
#   - no extensions, no component extensions, no sync, no background networking, no
#     remote-debugging port, so nothing on the machine can attach to it;
#   - no downloads, pop-ups, modal dialogs or navigation of the window: the game runs in an
#     iframe sandboxed with scripts and its own storage only (frame_page in director.py).
# 561 is sealed and holds no personal data (yos-mcp-sealed).
#
# Usage: showcase-browser FRAME.html
set -u
frame=${1:?usage: showcase-browser FRAME.html}
command -v chromium >/dev/null || { echo "chromium is not installed"; exit 2; }

profile=$(mktemp -d)
pid=
# Chromium stopped first, then its profile removed, however this script ends.
cleanup() {
    [ -n "$pid" ] && kill "$pid" 2>/dev/null && wait "$pid" 2>/dev/null
    rm -rf "$profile"
}
trap cleanup EXIT
trap 'exit 143' TERM INT HUP

# Not exec: this script must outlive Chromium to remove its profile.
chromium --ozone-platform=wayland --user-data-dir="$profile" \
    --app="file://$frame" --window-size=960,1080 \
    --proxy-server="http://127.0.0.1:9" --proxy-bypass-list="<-loopback>" \
    --host-resolver-rules="MAP * ~NOTFOUND" \
    --disable-extensions --disable-component-extensions-with-background-pages \
    --disable-background-networking --disable-sync --disable-default-apps \
    --disable-features=Translate,MediaRouter,OptimizationHints,AutofillServerCommunication \
    --no-first-run --no-default-browser-check --no-pings --disable-breakpad \
    --password-store=basic --mute-audio --noerrdialogs --deny-permission-prompts &
pid=$!
wait "$pid"
status=$?
pid=
exit "$status"
