#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════════════
# yantrik-update — check for, apply, and roll back OS updates on an installed Yantrik system.
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# The release server already publishes everything an update needs: one `.tar.zst` bundle per
# channel, its sha256, and a manifest saying which build each channel points at
# (build-release.sh --publish). Until now nothing on the installed side could *read* that and
# act — `version.rs` checks the manifest and lights a button, and the button did nothing. So
# updating a machine meant what it meant all through this project's bring-up: hand-copying
# binaries over ssh and restarting the shell by hand. This is that, done properly and safely.
#
# The safety it adds over a hand-copy is the part that matters:
#   * the bundle is verified against the manifest's sha256 before a single file is touched,
#   * the current binaries are backed up before they are replaced, and
#   * if the new shell does not answer its control socket after the restart, the update is
#     rolled back to the backup automatically — a bad build cannot leave the machine dark.
#
# Usage:
#   yantrik-update check      [--channel C]           what is installed vs what the channel has
#   yantrik-update apply      [--channel C] [--force] [--reboot] [--no-restart]
#   yantrik-update rollback                            restore the most recent backup
#   yantrik-update status                              current build + available backups
#
# It reads its defaults from /opt/yantrik/update.conf (CHANNEL=, HOST=) when present.

set -uo pipefail

# ── Where things live ───────────────────────────────────────────────────────────────────
PREFIX="${YANTRIK_PREFIX:-/opt/yantrik}"
BIN_DIR="$PREFIX/bin"
# Everything a release ships that is not a binary: the compositor config and window theme, the
# house typeface, the session autostart, and the .desktop entry for every app.
SHARE_DIR="$PREFIX/share"
BUILD_FILE="$PREFIX/BUILD"
UPDATES_DIR="$PREFIX/updates"
BACKUP_DIR="$PREFIX/backups"
CONF="$PREFIX/update.conf"
# The systemd unit that owns the desktop session.
SESSION_UNIT="${YANTRIK_SESSION_UNIT:-yantrik-session.service}"
LOG_DIR="$PREFIX/logs"
LOG_FILE="$LOG_DIR/yantrik-os.log"

# Config file may set CHANNEL and HOST. It is plain KEY=value, sourced only for those two.
CHANNEL_DEFAULT="stable"
HOST_DEFAULT="releases.yantrikos.com"
if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi
CHANNEL="${CHANNEL:-$CHANNEL_DEFAULT}"
HOST="${HOST:-$HOST_DEFAULT}"

# ── Small helpers ───────────────────────────────────────────────────────────────────────
c_bold=$'\033[1m'; c_red=$'\033[31m'; c_grn=$'\033[32m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s%s%s\n' "$c_bold" "$*" "$c_off"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '%s  %s%s\n' "$c_red" "$*" "$c_off" >&2; }
fail() { printf '%sFAIL: %s%s\n' "$c_red" "$*" "$c_off" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || fail "need '$1' but it is not installed"; }

# Pull a `--channel X` out of the argument list and let it override the configured channel. Both
# `check` and `apply` take it, so it is parsed in one place rather than two that could disagree.
parse_channel() {
  local prev=""
  for a in "$@"; do
    if [ "$prev" = "--channel" ]; then CHANNEL="$a"; fi
    prev="$a"
  done
}

# The one field from the manifest we cannot do without, pulled with python for correctness
# (the manifest is JSON and grepping JSON is how you ship the wrong build).
manifest_field() {
  # $1 = channel, $2 = field. HOST comes through the environment so the quoted heredoc below
  # stays literal (expanding a shell var inside it is how you ship a malformed request).
  YANTRIK_UPDATE_HOST="$HOST" python3 - "$1" "$2" <<'PY' 2>/dev/null
import sys, os, json, urllib.request
channel, field = sys.argv[1], sys.argv[2]
host = os.environ.get("YANTRIK_UPDATE_HOST", "releases.yantrikos.com")
for url in (f"http://{host}/manifest.json", "http://192.168.4.28/manifest.json"):
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            m = json.load(r)
        ch = m.get("channels", {}).get(channel, {})
        v = ch.get(field, "")
        if v != "":
            print(v)
        sys.exit(0)
    except Exception:
        continue
sys.exit(1)
PY
}

# Read a KEY from the installed BUILD marker, or empty if absent.
build_field() {
  [ -f "$BUILD_FILE" ] || return 0
  sed -n "s/^$1=//p" "$BUILD_FILE" | head -1
}

installed_git()     { build_field git; }
installed_version() { build_field version; }

# ── check ───────────────────────────────────────────────────────────────────────────────
cmd_check() {
  need python3
  parse_channel "$@"
  say "Checking channel '$CHANNEL' on $HOST"
  local remote_ver remote_git local_ver local_git
  remote_ver="$(manifest_field "$CHANNEL" version)" || fail "cannot reach the release server or channel '$CHANNEL' is not published"
  remote_git="$(manifest_field "$CHANNEL" git)"
  local_ver="$(installed_version)"; local_git="$(installed_git)"

  info "installed: ${local_ver:-unknown}${local_git:+ ($local_git)}"
  info "channel:   ${remote_ver:-unknown}${remote_git:+ ($remote_git)}"

  if [ -z "$local_git" ]; then
    printf '%supdate available%s — this machine has no build marker, so it cannot prove it is current\n' "$c_bold" "$c_off"
    return 10
  fi
  if [ "$local_git" = "$remote_git" ]; then
    printf '%sup to date%s\n' "$c_grn" "$c_off"
    return 0
  fi
  printf '%supdate available%s: %s → %s\n' "$c_bold" "$c_off" "${local_git:-unknown}" "${remote_git:-unknown}"
  return 10
}

# ── apply ───────────────────────────────────────────────────────────────────────────────
cmd_apply() {
  need python3; need curl; need sha256sum; need tar
  parse_channel "$@"
  local force=0 reboot=0 restart=1
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      --reboot) reboot=1 ;;
      --no-restart) restart=0 ;;
    esac
  done

  say "Preparing update from channel '$CHANNEL'"
  local remote_git remote_ver artifact remote_sha
  remote_ver="$(manifest_field "$CHANNEL" version)" || fail "cannot reach the release server"
  remote_git="$(manifest_field "$CHANNEL" git)"
  artifact="$(manifest_field "$CHANNEL" artifact)"
  remote_sha="$(manifest_field "$CHANNEL" sha256)"
  [ -n "$artifact" ] || fail "channel '$CHANNEL' publishes no artifact — nothing to download"
  [ -n "$remote_sha" ] || fail "channel '$CHANNEL' publishes no sha256 — refusing to install an unverifiable build"

  local local_git; local_git="$(installed_git)"
  if [ "$force" = 0 ] && [ -n "$local_git" ] && [ "$local_git" = "$remote_git" ]; then
    say "Already on $remote_git — nothing to do (use --force to reinstall)"
    return 0
  fi

  mkdir -p "$UPDATES_DIR"
  local dl="$UPDATES_DIR/$artifact"

  say "Downloading $artifact"
  local url="http://$HOST/$CHANNEL/$artifact"
  if ! curl -fL --retry 3 --connect-timeout 15 -o "$dl" "$url"; then
    # Fall back to the release server's IP, the same way the manifest read does.
    warn "download from $HOST failed; trying 192.168.4.28"
    curl -fL --retry 3 --connect-timeout 15 -o "$dl" "http://192.168.4.28/$CHANNEL/$artifact" \
      || fail "could not download the update bundle"
  fi

  say "Verifying"
  local got; got="$(sha256sum "$dl" | awk '{print $1}')"
  if [ "$got" != "$remote_sha" ]; then
    rm -f "$dl"
    fail "sha256 mismatch — expected $remote_sha, got $got. The download is corrupt or tampered; nothing was changed."
  fi
  info "sha256 ok ($got)"

  say "Unpacking"
  local stage="$UPDATES_DIR/staging"
  rm -rf "$stage"; mkdir -p "$stage"
  tar --use-compress-program='zstd -d' -xf "$dl" -C "$stage" 2>/dev/null \
    || tar -xf "$dl" -C "$stage" \
    || fail "could not unpack the bundle (need zstd for .tar.zst)"
  # The bundle holds one top directory <NAME>/ with bin/ under it.
  local root; root="$(find "$stage" -maxdepth 1 -mindepth 1 -type d | head -1)"
  [ -n "$root" ] && [ -d "$root/bin" ] || fail "the bundle has no bin/ directory — it is not a Yantrik release"

  # A release that does not contain the shell is not a release; refuse before touching anything.
  [ -f "$root/bin/yantrik-ui" ] || fail "the bundle has no yantrik-ui — refusing to install it"
  local n; n="$(find "$root/bin" -maxdepth 1 -type f | wc -l)"
  [ "$n" -ge 10 ] || fail "the bundle has only $n binaries — that is not a whole OS, refusing"
  info "$n binaries staged"

  # ── Back up what is there now, so a bad build is recoverable ──
  local ts; ts="$(date -u +%Y%m%d-%H%M%S)"
  local backup="$BACKUP_DIR/$ts"
  say "Backing up current build to $backup"
  mkdir -p "$backup"
  cp -a "$BIN_DIR" "$backup/bin"
  [ -d "$SHARE_DIR" ] && cp -a "$SHARE_DIR" "$backup/share"
  [ -f "$BUILD_FILE" ] && cp -a "$BUILD_FILE" "$backup/BUILD"
  echo "$backup" > "$UPDATES_DIR/last-backup"

  # ── Swap: install each new binary over the old, atomically per file ──
  say "Installing"
  local installed=0
  while IFS= read -r f; do
    local base; base="$(basename "$f")"
    local tmp="$BIN_DIR/.$base.new"
    if cp "$f" "$tmp" 2>/dev/null && chmod 755 "$tmp" && mv -f "$tmp" "$BIN_DIR/$base"; then
      installed=$((installed + 1))
    else
      # A single file failing to install is a failed update; put everything back.
      rm -f "$tmp"
      warn "could not install $base — rolling back"
      restore_backup "$backup"
      fail "install failed at $base; rolled back to the previous build"
    fi
  done < <(find "$root/bin" -maxdepth 1 -type f)
  info "installed $installed binaries"

  # ── And everything that is not a binary ──
  #
  # The updater installed bin/ and nothing else, so half of every release since this script
  # was written went in the bin and stayed there. share/ carries the compositor config, the
  # window theme, the house typeface, the autostart file and the .desktop entries for all
  # sixteen apps — none of which ever reached an installed machine.
  #
  # It was invisible because each piece had an innocent explanation. The keyboard shortcuts
  # "had not been deployed yet". The launcher "did not know about our apps". The desktop
  # "needed a reboot to pick up the theme". They were all the same missing copy.
  #
  # Mirrored rather than merged: a file dropped from a release should disappear from the
  # machine too, and --delete is what makes the installed tree equal the shipped one.
  if [ -d "$root/share" ]; then
    mkdir -p "$SHARE_DIR"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "$root/share/" "$SHARE_DIR/" || fail "could not install share/"
    else
      rm -rf "$SHARE_DIR" && mkdir -p "$SHARE_DIR"
      cp -a "$root/share/." "$SHARE_DIR/" || fail "could not install share/"
    fi
    info "installed $(find "$SHARE_DIR" -type f | wc -l) shared files"
  fi

  # Record the new build so `check` can prove currency next time.
  cat > "$BUILD_FILE" <<EOF
name=${artifact%.tar.zst}
version=$remote_ver
git=$remote_git
channel=$CHANNEL
installed=$(date -u +%Y-%m-%dT%H:%M:%SZ)
binaries=$installed
EOF

  rm -rf "$stage"; rm -f "$dl"
  say "Installed $remote_ver ($remote_git)"

  if [ "$reboot" = 1 ]; then
    say "Rebooting"
    exec sudo reboot
  fi
  if [ "$restart" = 1 ]; then
    restart_and_verify "$backup"
  else
    info "not restarting (--no-restart); the new build takes effect on next session start"
  fi
}

# Restart the shell in the current session, then confirm it answers its control socket. If it
# does not come up, roll back and restart the old one — the machine must never be left dark.
# Remember the environment the RUNNING shell has, before killing it.
#
# An update restarts the shell, and the restarted shell must be the same program in the same
# session -- not a similar one started by hand with three variables someone thought of.
#
# The version of this that listed variables explicitly passed XDG_RUNTIME_DIR, WAYLAND_DISPLAY
# and SLINT_BACKEND. It did not pass SLINT_FULLSCREEN, which the session sets (cloud-init
# exports it before launching labwc). So after every update the OS came back as an 800-pixel
# DECORATED WINDOW floating on a black root, with a title bar and a close button. An operating
# system. The binaries were right and the desktop looked broken.
#
# Copying the live process's environment is the only version of this that stays correct when
# someone adds a variable to the session and does not think about the updater.
SHELL_ENV=()
capture_shell_env() {
  local pid
  pid="$(pgrep -x yantrik-ui 2>/dev/null | head -1)"
  [ -n "$pid" ] || return 1
  [ -r "/proc/$pid/environ" ] || return 1
  mapfile -d '' -t SHELL_ENV < "/proc/$pid/environ" || return 1
  [ "${#SHELL_ENV[@]}" -gt 0 ]
}

# Start the shell, detached, so it outlives this script.
#
# `mkdir -p` on the log directory is the other half of why this function exists. Without it the
# append redirect fails, the shell never launches at all, and the update rolls back a perfectly
# healthy build with a message about a timeout. Worse: the rollback ran the same redirect, so
# it could not restart the OLD shell either -- one absent directory took a machine dark and
# reported it as "the previous build is running again".
start_shell() {
  local runtime="$1"
  mkdir -p "$PREFIX/logs" 2>/dev/null || true

  if [ "${#SHELL_ENV[@]}" -gt 0 ]; then
    # The session's own environment, verbatim.
    setsid env "${SHELL_ENV[@]}" \
      "$BIN_DIR/yantrik-ui" "$PREFIX/config.yaml" >> "$LOG_FILE" 2>&1 &
  else
    # Nothing was running to copy from. SLINT_FULLSCREEN is named here on purpose: a shell
    # without it is a window, and a window is the one thing this is not.
    setsid env \
      XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
      SLINT_BACKEND="${SLINT_BACKEND:-winit}" SLINT_FULLSCREEN="${SLINT_FULLSCREEN:-1}" \
      "$BIN_DIR/yantrik-ui" "$PREFIX/config.yaml" >> "$LOG_FILE" 2>&1 &
  fi
}

# Wait for the shell to answer its control socket. The socket existing is not enough: it is
# created before the shell is ready to be asked anything.
wait_for_shell() {
  local runtime="$1"
  local sock="$runtime/yantrik/app-shell.sock"
  say "Waiting for the shell to answer"
  for _ in $(seq 1 30); do
    if [ -S "$sock" ] && "$BIN_DIR/yos" describe shell >/dev/null 2>&1; then
      printf '%shealthy — update complete%s\n' "$c_grn" "$c_off"
      return 0
    fi
    sleep 1
  done
  return 1
}

restart_and_verify() {
  local backup="$1"
  say "Restarting the shell"
  local runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ ! -S "$runtime/yantrik/app-shell.sock" ] && [ ! -d "$runtime/yantrik" ]; then
    warn "no Yantrik session on this runtime dir ($runtime) — cannot restart from here."
    info "the new build will take effect the next time the desktop session starts."
    return 0
  fi

  # Ask the session manager to restart the session, rather than respawning the shell by hand.
  #
  # This is the correction to a whole class of damage. Hand-spawning looked fine and was not:
  # the replacement shell is a child of whatever ran the updater — an ssh login, in practice —
  # so it inherits that environment instead of the session's, and it is no longer a startup
  # child of the compositor. It came back with XDG_SESSION_TYPE=tty, no DISPLAY, and
  # SSH_CONNECTION set, running outside labwc's supervision.
  #
  # The visible result was a desktop that tore and flickered whenever a second client was on
  # screen, and an OS that had to be told SLINT_FULLSCREEN or it drew itself as a window. Both
  # were blamed on the compositor and on rendering. Neither was: a clean boot of the same build
  # renders Chromium perfectly, with two successive frames byte-identical.
  #
  # Every desktop does this with its session manager. So do we now: systemd started this
  # session and knows exactly how to start it again — the unit carries XDG_SESSION_TYPE,
  # the seat, the tty and the renderer settings, and labwc re-exports DISPLAY,
  # XDG_CURRENT_DESKTOP and the rest to its children. Restarting it reproduces the boot path
  # exactly, which is the only restart worth trusting.
  if command -v systemctl >/dev/null 2>&1 \
     && systemctl cat "$SESSION_UNIT" >/dev/null 2>&1; then
    info "restarting $SESSION_UNIT"
    if sudo -n systemctl restart "$SESSION_UNIT" 2>/dev/null; then
      wait_for_shell "$runtime" && return 0
      warn "the session restarted but the shell did not answer"
      restore_backup "$backup"
      sudo -n systemctl restart "$SESSION_UNIT" 2>/dev/null
      wait_for_shell "$runtime" \
        && fail "update rolled back — the previous build is running again"
      fail "update rolled back, but the session did not come back. Start it with: \
sudo systemctl restart $SESSION_UNIT"
    fi
    warn "could not restart $SESSION_UNIT without a password; starting the shell directly"
  fi

  # No session unit, or no privilege to restart it: a development machine where somebody
  # started the shell by hand. Do the same thing they did.
  #
  # Before the kill, or there is nothing left to read the environment from.
  capture_shell_env || warn "no running shell to copy the session environment from"

  pkill -x yantrik-ui 2>/dev/null
  sleep 3
  pkill -9 -x yantrik-ui 2>/dev/null
  sleep 1
  start_shell "$runtime"

  say "Waiting for the shell to answer"
  local sock="$runtime/yantrik/app-shell.sock"
  for _ in $(seq 1 20); do
    if [ -S "$sock" ] && "$BIN_DIR/yos" describe shell >/dev/null 2>&1; then
      printf '%shealthy — update complete%s\n' "$c_grn" "$c_off"
      return 0
    fi
    sleep 1
  done

  warn "the new shell did not answer within 20s — rolling back"
  # Say WHY before rolling back. A rollback with no reason attached turns a five-minute fix
  # into an afternoon, and the log is the only witness the new shell leaves behind.
  if [ -s "$LOG_FILE" ]; then
    warn "last lines from $LOG_FILE:"
    tail -n 15 "$LOG_FILE" | sed 's/^/    /'
  else
    warn "$LOG_FILE is empty — the new shell wrote nothing before it stopped"
  fi

  restore_backup "$backup"
  pkill -9 -x yantrik-ui 2>/dev/null
  sleep 1
  start_shell "$runtime"

  # Verify the ROLLBACK, rather than announcing one that did not happen. The restore used to
  # print "the previous build is running again" without ever checking, and on the day the log
  # directory was missing it said exactly that while the machine sat dark.
  local sock_rb="$runtime/yantrik/app-shell.sock"
  for _ in $(seq 1 20); do
    if [ -S "$sock_rb" ] && "$BIN_DIR/yos" describe shell >/dev/null 2>&1; then
      fail "update rolled back — the previous build is running again"
    fi
    sleep 1
  done
  fail "update rolled back, but the previous build did not answer either — this machine has \
no shell running. Start one with: $BIN_DIR/yantrik-ui $PREFIX/config.yaml"
}

# Copy a backup's binaries back over the live ones, and restore its build marker.
restore_backup() {
  local backup="$1"
  [ -d "$backup/bin" ] || { warn "backup $backup has no bin/ — cannot restore"; return 1; }
  while IFS= read -r f; do
    local base; base="$(basename "$f")"
    cp "$f" "$BIN_DIR/.$base.rb" 2>/dev/null && chmod 755 "$BIN_DIR/.$base.rb" && mv -f "$BIN_DIR/.$base.rb" "$BIN_DIR/$base"
  done < <(find "$backup/bin" -maxdepth 1 -type f)
  if [ -d "$backup/share" ]; then
    rm -rf "$SHARE_DIR"
    cp -a "$backup/share" "$SHARE_DIR"
  fi
  [ -f "$backup/BUILD" ] && cp -a "$backup/BUILD" "$BUILD_FILE"
  info "restored from $backup"
}

# ── rollback ────────────────────────────────────────────────────────────────────────────
cmd_rollback() {
  local backup
  backup="$(cat "$UPDATES_DIR/last-backup" 2>/dev/null)"
  [ -n "$backup" ] && [ -d "$backup" ] || {
    backup="$(find "$BACKUP_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort | tail -1)"
  }
  [ -n "$backup" ] && [ -d "$backup" ] || fail "no backup to roll back to"
  say "Rolling back to $backup"
  restore_backup "$backup"
  restart_and_verify "$backup"
}

# ── status ──────────────────────────────────────────────────────────────────────────────
cmd_status() {
  say "Yantrik build"
  if [ -f "$BUILD_FILE" ]; then
    sed 's/^/  /' "$BUILD_FILE"
  else
    info "no build marker at $BUILD_FILE"
  fi
  info "channel: $CHANNEL   host: $HOST"
  say "Backups"
  if [ -d "$BACKUP_DIR" ] && [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
    for b in "$BACKUP_DIR"/*/; do
      printf '  %s  (%s binaries)\n' "$(basename "$b")" "$(find "$b/bin" -maxdepth 1 -type f 2>/dev/null | wc -l)"
    done
  else
    info "none"
  fi
}

# ── dispatch ────────────────────────────────────────────────────────────────────────────
CMD="${1:-check}"; shift || true
case "$CMD" in
  check)    cmd_check "$@" ;;
  apply)    cmd_apply "$@" ;;
  rollback) cmd_rollback "$@" ;;
  status)   cmd_status "$@" ;;
  -h|--help|help)
    sed -n '20,30p' "$0" ;;
  *) fail "unknown command '$CMD' (check | apply | rollback | status)" ;;
esac
