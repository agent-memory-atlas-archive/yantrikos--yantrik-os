# The OS grades every action it publishes: safe < standard < sensitive < dangerous. Of the
# 46 actions on this desktop, 40 are `standard` — open a note, save, append, search — and
# six are not: killing a process, removing a container, locking the session.
#
# That grade is the OS's own judgement about its own surface, and it is finer than anything
# this bridge could infer, so it is what decides. Everything at or below the ceiling runs;
# anything above it is refused HERE, in the process that would otherwise make the call.
# A caller cannot argue with it, because the refusal is not advice passed upstream — it is
# the absence of an invocation.
def act_pairs(a):
    """Turn an os_act call's arguments into the key=value pairs `yos act` expects.

    A model asked to append a line will often send the line itself where an object was
    specified — `"args": "the text"` rather than `{"text": "the text"}`. That is a
    reasonable thing to have meant, and refusing it teaches nothing: the caller cannot see
    which parameter name it should have used without another round trip. So a bare string
    is resolved against the action's own schema, and only genuinely ambiguous cases fail.
    """
    args = a.get("args")
    if not args:
        return []

    if isinstance(args, str):
        # It may simply be JSON that arrived as text.
        try:
            parsed = json.loads(args)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            args = parsed
        else:
            names = action_parameters(a.get("app"), a.get("action"))
            if len(names) == 1:
                args = {names[0]: args}
            else:
                raise ValueError(
                    "args arrived as a bare value but %s.%s takes %s. Send an object, e.g. "
                    '{"%s": ...}.' % (a.get("app"), a.get("action"),
                                      ("no parameters" if not names else "parameters " + ", ".join(names)),
                                      names[0] if names else "param")
                )

    if not isinstance(args, dict):
        raise ValueError("args must be an object of parameter names to values, got %s"
                         % type(args).__name__)

    # Values are stringified rather than json-dumped so a plain string arrives as
    # `text=hello`, not `text="hello"` with the quotes becoming part of the note.
    return ["%s=%s" % (k, v if isinstance(v, str) else json.dumps(v)) for k, v in args.items()]


def yos(args, timeout):
    """Run `yos` and hand back the completed process, or None if it could not run at all.

    One place, because five callers now need the same environment: yos reaches the compositor's
    session bus and the audio server, and without those it sees an empty desktop and reports
    that as fact.
    """
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    try:
        return subprocess.run([YOS] + list(args), capture_output=True, text=True,
                              timeout=timeout, env=env)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return None


def action_parameters(app, action):
    """The parameter names one action takes, read from the OS's own description of it."""
    if not app or not action:
        return []
    p = yos(["describe", app], SHELL_CALL_TIMEOUT)
    if p is None or p.returncode != 0:
        return []
    for m in re.finditer(r"^\s*act:\s*([A-Za-z0-9_]+)\(([^)]*)\)", p.stdout, re.M):
        if m.group(1) == action:
            return [n.strip() for n in m.group(2).split(",") if n.strip()]
    return []


def effective_args(a):
    """The arguments as the app will actually receive them.

    This matters because a grant is bound to exact values. os_act renders every value to text
    for `yos act k=v`, and `yos` parses each one back with `json.loads` — a round trip that is
    lossy in a specific way: "3" arrives as 3, "true" as True. Binding the approval to what the
    model typed rather than to what the app will run with would mean the card showed one thing
    and the machine did another, which is the whole failure this feature exists to prevent.
    So the round trip happens once, here, and the same dict is what the card shows, what the
    grant binds, and what the call sends.

    Raises ValueError for arguments that cannot be resolved — the same error, from the same
    helper, that building the command line would have raised a moment later.
    """
    out = {}
    for pair in act_pairs(a):
        key, value = pair.split("=", 1)
        try:
            out[key] = json.loads(value)
        except ValueError:
            out[key] = value
    return out


# ── Keeping private data from walking out ───────────────────────────────────────────────
#
# A leak needs three things at once: reach into private data, exposure to content someone
# else wrote, and a way to send outward. An agent on this desktop has all three, so one of
# them has to be broken.
#
# The naive break — taint on reading a web page — makes the browser useless: read a search
# page, and you can no longer type in its search box. So the taint tracks the leg that is
# actually diagnostic: has this session looked at anything PRIVATE? Browsing stays free for
# a session that has only ever seen the open web, because a session that has seen no secrets
# has none to spend. The moment it reads app state, machine events or machine audio, putting
# data into a page stops being free.
#
# Scope is the process. A harness spawns this bridge once and keeps it, so process lifetime
# is session lifetime. There is deliberately NO tool to clear the taint — a caller that can
# untaint itself is not constrained, and the only way back is a new session, which is a
# person's decision rather than an agent's.
PRIVATE_READS = {"os_describe", "os_perception", "web_listen"}
OUTBOUND = {"web_type", "web_go"}

_SAW_PRIVATE = []          # what tainted this session, in order, for the refusal message
TAINT_OFF = os.environ.get("YOS_MCP_NO_TAINT") == "1"


def payload_in_url(url):
    """Does this URL carry data, as opposed to just naming a place?

    A query string, a fragment, or userinfo can carry anything. Those are the shapes a
    secret leaves in; a bare path is navigation. Length alone is not the test — a long
    article path is innocent and a short ?k= is not.
    """
    try:
        from urllib.parse import urlsplit
        u = urlsplit(url)
    except Exception:
        return True  # unparseable is not a reason to allow it
    if u.query or u.fragment:
        return True
    if "@" in (u.netloc or ""):
        return True
    return False


def taint_refusal(name, args):
    """Refuse an outbound call once this session has seen private data. None = allow."""
    if TAINT_OFF or not _SAW_PRIVATE or name not in OUTBOUND:
        return None
    if name == "web_go" and not payload_in_url(args.get("url", "")):
        # Plain navigation carries nothing out; going somewhere is not saying something.
        return None
    saw = ", ".join(dict.fromkeys(_SAW_PRIVATE))
    what = "type into a page" if name == "web_type" else "open a URL carrying data in it"
    return ("this session has already read private state (%s), so it will not %s. "
            "Whatever is on this machine could be carried out that way, and nothing here "
            "can tell an innocent string from a secret. A person has to do this part, or "
            "start a fresh session that has not read anything private." % (saw, what))



LADDER = ["safe", "standard", "sensitive", "dangerous"]
CEILING = os.environ.get("YOS_MCP_MAX_PERMISSION", "standard")


def action_detail(app, action):
    """How the OS grades one of its own actions, and what the app says the action is for.

    Returns `(grade, purpose)`. The grade is None when it cannot be established — a missing
    app, a renamed action, a describe that would not answer. None is not "safe": an ungradeable
    action is refused, because the failure that matters here is running something whose cost was
    never read.

    It returns the purpose as well as the grade because the purpose is what a person is actually
    shown when they are asked. The app publishes it for every action ("Delete an event from the
    calendar. It is not recoverable."), `yos describe` prints it under the signature since
    d73760d, and a card that showed `calendar.delete_event` and six arguments without that
    sentence would be asking somebody to authorise a name.

        `  act: delete_event(id)  [sensitive, settles on return]`
        `       Delete an event from the calendar. It is not recoverable.`
        `         id: string — the event's id, as list_events reports it`

    Two-space signature, seven-space purpose, nine-space arguments — so the purpose is the line
    under the signature indented past it but not as far as an argument.
    """
    p = yos(["describe", app], SHELL_CALL_TIMEOUT)
    if p is None or p.returncode != 0:
        return None, ""
    lines = (p.stdout or "").splitlines()
    for i, line in enumerate(lines):
        m = re.match(r"^\s*act:\s*([A-Za-z0-9_]+)\([^)]*\)\s*\[([a-z]+),", line)
        if not m or m.group(1) != action:
            continue
        purpose = ""
        if i + 1 < len(lines):
            after = lines[i + 1]
            if after.startswith("       ") and not after.startswith("         "):
                purpose = after.strip()
        return m.group(2), purpose
    return None, ""


def machine_ceiling():
    """This machine's standing policy for callers on the socket, or None if it cannot be read.

    Published by the shell in `describe shell` as `tool_permission` — the same value
    `yantrik-app-runtime::control` enforces inside every `app.act`, read from the same settings
    file, not the Settings screen's copy of it.

    Read rather than guessed, and read rather than provoked. The other way to learn this limit is
    to attempt the action and read the `CEILING:` refusal that comes back, which means doing the
    thing we are deciding about. An approval must not be able to exceed the owner's standing
    policy, and a person asked a question no answer of theirs could satisfy learns that the card
    is noise.
    """
    p = yos(["describe", "shell"], SHELL_CALL_TIMEOUT)
    if p is None or p.returncode != 0:
        return None
    m = re.search(r'"tool_permission"\s*:\s*"([a-z]+)"', p.stdout or "")
    if not m or m.group(1) not in LADDER:
        return None
    return m.group(1)


def result_object(text):
    """The `result` object out of what `yos act` printed, or None.

    `yos act` prints a summary line, an `accepted:` line, a revision, and then the action's own
    result as `json.dumps(..., indent=2)` — which starts with a bare `{` in column zero. That is
    the anchor; everything before it is prose for a person.
    """
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if line == "{":
            try:
                return json.JSONDecoder().raw_decode("\n".join(lines[i:]))[0]
            except ValueError:
                return None
    return None


def shell_call(action, args):
    """One action on the shell's own control surface. Returns `(result, error)`.

    Values are passed the way `yos act` expects them and `yos` parses each back with
    `json.loads`, so `args_json` — a dict here — arrives at the shell as an object rather than
    as a string. The shell accepts both shapes and canonicalises in one place, so a grant
    requested through this path and consumed through it bind to the same bytes.
    """
    argv = ["act", "shell", action]
    for key, value in args.items():
        argv.append("%s=%s" % (key, value if isinstance(value, str) else json.dumps(value)))
    p = yos(argv, SHELL_CALL_TIMEOUT)
    if p is None:
        return None, "the desktop did not answer within %ss" % SHELL_CALL_TIMEOUT
    if p.returncode != 0:
        return None, ((p.stderr or "").strip() or (p.stdout or "").strip()
                      or "the desktop refused it and said nothing")
    result = result_object(p.stdout or "")
    if result is None:
        return None, "the desktop answered but %s printed nothing that could be read" % action
    return result, None


def ask_the_person(app, action, grade, purpose, args):
    """Put one action in front of the person, wait, and report exactly what happened.

    Returns `(allowed, message)`. The message is the whole account the mind gets, and it is
    written to be reported onwards as-is: a person who asked for something ordinary should hear
    what their machine did, not a paraphrase of a status code.

    The three steps are the shell's, and none of them decides anything: `request_approval` puts
    a card up, `approval_status` reads an answer somebody else gave, `consume_approval` spends a
    grant that only a click created. There is no action anywhere on this desktop that grants.
    """
    request, err = shell_call("request_approval", {
        "app": app,
        "action": action,
        "grade": grade,
        "purpose": purpose,
        "args_json": args,
        "requester": REQUESTER,
    })
    if request is None:
        return False, (
            "%s.%s is graded %s, above this session's %s ceiling, so it needs the person at the "
            "machine to allow it — and they could not be asked: %s. Nothing was run and nothing "
            "was changed. Tell them what you were trying to do and let them decide."
            % (app, action, grade, CEILING, err))

    request_id = request.get("request_id")
    if not request_id:
        return False, (
            "the desktop was asked to put an approval card up for %s.%s and did not say which "
            "request it was, so there is nothing to wait on. Nothing was run." % (app, action))

    # Polled rather than pushed: this bridge has no way to be called back, and a person cannot
    # answer inside the first poll interval anyway.
    deadline = time.monotonic() + APPROVAL_WAIT
    status = "pending"
    while time.monotonic() < deadline:
        time.sleep(APPROVAL_POLL)
        poll, err = shell_call("approval_status", {"request_id": request_id})
        if poll is None:
            return False, (
                "the person was shown a card asking them to allow %s.%s, and then the desktop "
                "stopped answering: %s. Nothing was run here. They may have allowed it; this "
                "bridge cannot tell, and it will not run it on a guess." % (app, action, err))
        status = poll.get("status", "pending")
        if status != "pending":
            break

    if status == "granted":
        spent, err = shell_call("consume_approval", {
            "request_id": request_id, "app": app, "action": action, "args_json": args,
        })
        if spent is None:
            # The grant exists and this call could not spend it. Not running is the only safe
            # reading: the refusal may be precisely that the arguments do not match what the
            # person was shown.
            return False, (
                "the person allowed %s.%s, but the grant could not be spent: %s. Nothing was "
                "run. Tell them it did not go through." % (app, action, err))
        return True, (
            "The person at the machine was asked and allowed this once, just now, for exactly "
            "these arguments. The grant has been spent and cannot be used again — a further "
            "call at this grade will ask them again.")

    if status == "denied":
        return False, (
            "the person at the machine was asked to allow %s.%s and said no. Nothing was run "
            "and nothing was changed. This is an answer, not an error: do not ask again and do "
            "not look for another route to the same effect. Say what you were going to do and "
            "leave it with them." % (app, action))

    if status == "consumed":
        return False, (
            "the grant for %s.%s had already been spent, so nothing was run. A grant covers one "
            "action once; ask again if it still needs doing." % (app, action))

    # `expired`, or still `pending` when the wait ran out. From the person's side these are the
    # same thing — they did not answer — and saying so is better than reporting a timeout that
    # sounds like a fault.
    return False, (
        "the person at the machine was asked to allow %s.%s and did not answer within %ds, so "
        "nothing was run. They were probably away from the keyboard. Tell them what you were "
        "trying to do; they can ask you to try it again."
        % (app, action, APPROVAL_WAIT))


def guard_act(args):
    """Decide whether this action runs, asking the person when it is above this session's ceiling.

    Returns `(refusal, note)`: a refusal to hand back instead of running, or no refusal and a
    note to carry back beside the action's own output.

    This used to be a wall. `delete_event` is graded `sensitive`, this bridge's ceiling is
    `standard`, and somebody who typed "delete the dentist appointment from my calendar" was
    told to raise an environment variable. The grade was right and the refusal was right; what
    was missing was any way to ask. There is one now, and the ladder below it is unchanged —
    what was refused is now a question, and only a person's click answers it.
    """
    app, action = args.get("app"), args.get("action")
    if not app or not action:
        return ("os_act needs both an app and an action — see os_describe for what an app "
                "offers."), None

    level, purpose = action_detail(app, action)
    if level is None:
        return ("cannot establish how %r grades %r, so it will not be run. Check the name "
                "with os_describe %s." % (app, action, app)), None
    if level not in LADDER:
        return ("%s.%s is graded %r, which is not a level this OS defines. Refusing."
                % (app, action, level)), None
    if LADDER.index(level) <= LADDER.index(CEILING):
        return None, None

    # Above this session's ceiling, so the person gets asked — unless the machine's own standing
    # policy already says no. That policy is the owner's, set at the keyboard in Settings, and an
    # approval must not be able to exceed it: a card allowed here would still be refused by the
    # app itself with a `CEILING:` message, and the person would have pressed Allow for nothing.
    machine = machine_ceiling()
    if machine is not None and LADDER.index(level) > LADDER.index(machine):
        return ("%s.%s is graded %s, and this machine does not allow callers like this past %s "
                "(`tool_permission`, on the AI page in Settings). The person was NOT asked, "
                "because nothing they could answer would let it run — this limit is the "
                "machine's standing policy, not this session's. Say what you were trying to do; "
                "only someone at the keyboard can change that setting."
                % (app, action, level, machine)), None

    try:
        bound = effective_args(args)
    except ValueError as e:
        return str(e), None

    allowed, message = ask_the_person(app, action, level, purpose, bound)
    if allowed:
        return None, message
    return message, None


def run_tool(tool, args):
    """Invoke yos and return (text, is_error), whatever the outcome.

    A tool that raises loses the detail the mind needs to recover, so a failure comes
    back as content that says what failed. The distinction that matters downstream is
    "the machine answered and the answer was no" versus "nothing answered at all", and
    both are reported in words rather than as an empty string.

    And flagged, not only worded. Every refusal and failure used to go back as ordinary
    content, which a client cannot tell from success: on the first live drive a refused
    action was reported to the person as "Done — refused: …". MCP marks a tool that ran
    and failed with isError; that is what the flag is for.
    """
    # Required arguments, said plainly. A call without one used to fail inside argv as a bare
    # KeyError — "could not run os_describe: 'app'" — which tells a model nothing it can act on.
    missing = [k for k in tool.get("inputSchema", {}).get("required", []) if not args.get(k)]
    if missing:
        return ("%s needs %s. %s" % (
            tool["name"], " and ".join(repr(k) for k in missing),
            "Say which app, e.g. {\"app\": \"shell\"} for the desktop." if "app" in missing else "",
        )).strip(), True

    # What the person said, when they were asked. Carried back on the successful path too, so a
    # mind reporting "done" also reports that somebody authorised it — the difference between
    # "I deleted it" and "you allowed it and I deleted it" is the whole point of asking.
    note = None

    if tool["name"] == "os_act":
        # os_describe lists actions as `act: new_note()`, and a model copying that sends
        # "new_note()". The name is the part before the parenthesis; refusing the call over the
        # punctuation cost a whole confirmed turn on the third live drive.
        args = dict(args)
        args["action"] = str(args["action"]).strip().split("(", 1)[0].strip()
        refusal, note = guard_act(args)
        if refusal is not None:
            return "refused: " + refusal, True

    refusal = taint_refusal(tool["name"], args)
    if refusal is not None:
        return "refused: " + refusal, True

    try:
        argv = [YOS] + tool["argv"](args)
    except ValueError as e:
        return "refused: %s" % e, True
    timeout = tool["timeout"]
    if callable(timeout):
        timeout = timeout(args)

    env = dict(os.environ)
    # yos reaches the compositor's session bus and the audio server; without these it
    # sees an empty desktop and reports that as fact, which is worse than an error.
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")

    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=env)
    except subprocess.TimeoutExpired:
        return (prefix(note, "timed out after %ss — the desktop did not answer. It may be busy "
                            "rather than broken; nothing was rolled back." % timeout)), True
    except FileNotFoundError:
        return "%s is not installed on this machine, so the desktop cannot be reached." % YOS, True

    out = (p.stdout or "").strip()
    err = (p.stderr or "").strip()
    app = args.get("app")
    if p.returncode != 0 and app and "no socket for" in err and tool["name"] in ("os_describe", "os_act"):
        # The second live drive: told the app was not running ("no socket for 'notes'"), the
        # model described it twice more and gave up. The way forward belongs in the failure
        # itself, where it is read, rather than only in a tool description read turns earlier.
        return (prefix(note, "%s is not running, so it cannot be described or acted on yet. "
                            "Open it first with os_act: app \"shell\", action \"open_app\", "
                            "args {\"name\": \"%s\"}; then describe it." % (app, app))), True
    if p.returncode != 0:
        # The note goes on a failure as well. A person who has just pressed Allow and then hears
        # only "failed (exit 1)" has been told the wrong half of what happened — and worse, the
        # grant is spent, so the retry will ask them again.
        return prefix(note, "failed (exit %d)%s%s" % (
            p.returncode,
            ("\n" + out) if out else "",
            ("\n" + err) if err else "",
        )), True
    if tool["name"] in PRIVATE_READS and p.returncode == 0:
        # Recorded after the call, not before: a read that failed saw nothing.
        _SAW_PRIVATE.append(tool["name"])

    if not out:
        return prefix(note, "(the command succeeded and printed nothing)"
                      + (("\n" + err) if err else "")), False
    return prefix(note, out + (("\n" + err) if err else "")), False


def prefix(note, text):
    """Put what the person decided in front of what the machine did, or leave the text alone."""
    return text if not note else note + "\n\n" + text


def reply(msg_id, result=None, error=None):
    m = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        m["error"] = error
    else:
        m["result"] = result
    # One message per line, no embedded newlines — the transport is line-delimited, and a
    # transcript full of newlines is exactly the payload that would break it.
    sys.stdout.write(json.dumps(m) + "\n")
    sys.stdout.flush()


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue

        method, msg_id = msg.get("method"), msg.get("id")

        if method == "initialize":
            reply(msg_id, {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "yantrik-os", "version": "1.0.0"},
            })
        elif method == "tools/list":
            # annotations tell a client what a tool does to the world, so it can run reads
            # freely and gate the rest. A client that has to guess from the name gets it
            # wrong: "os_apps" looks like a mutation to every heuristic worth writing.
            reply(msg_id, {"tools": [
                {k: t[k] for k in ("name", "description", "inputSchema", "annotations")
                 if k in t}
                for t in TOOLS
            ]})
        elif method == "tools/call":
            params = msg.get("params") or {}
            tool = BY_NAME.get(params.get("name"))
            if tool is None:
                reply(msg_id, error={"code": -32602,
                                     "message": "no such tool: %s" % params.get("name")})
                continue
            try:
                text, is_error = run_tool(tool, params.get("arguments") or {})
            except Exception as e:  # a malformed argument must not take the server down
                text, is_error = "could not run %s: %s" % (tool["name"], e), True
            reply(msg_id, {"content": [{"type": "text", "text": text}], "isError": is_error})
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601, "message": "unknown method: %s" % method})
        # Notifications (no id) get no reply, per JSON-RPC.


if __name__ == "__main__":
    main()
