# yantrik-splash-deactivate.service — before tty1's autologin, plymouth lets go of DRM master and the
# keyboard and stays alive, so its last frame, the emblem, stays on the screen until labwc draws
# (/usr/lib/yantrik/boot-unlock/splash; plymouth-quit.service quits it after the shell's first
# frame).
#
# A unit of its own, with no terminal: run from getty@tty1 it inherited that unit's tty1 and waited
# for plymouthd to let go of it before it could even start (#820). Bounded as a whole as well as
# per call; if it fails, getty@tty1 starts anyway (it only Wants this).
[Unit]
Description=Yantrik boot splash: plymouth lets go of the display, keeping the emblem on the screen
After=plymouth-start.service systemd-user-sessions.service
Before=getty@tty1.service

[Service]
Type=oneshot
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStart=-/usr/lib/yantrik/boot-unlock/splash deactivate
TimeoutStartSec=20
