#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════════════════
# splash release — plymouth lets go of tty1 and the display, leaving the emblem on the screen
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# plymouth draws the Yantrik emblem from the kernel's first frame (theme/yantrik.script), and asks
# for the disk's password in the same program when there is one. Stock, `plymouth quit` at
# multi-user.target clears the screen. Here it is `plymouth quit --retain-splash`: the emblem
# stays on the screen until something draws over it.
#
# Run by yantrik-splash-release.service, a oneshot with no terminal, ordered before
# getty@tty1.service; and in place of plymouth-quit.service's `plymouth quit`, for anything that
# boots without tty1's getty. It must not run in getty's own execution context. systemd takes
# tty1 for every Exec* line of getty@tty1, ExecStartPre included, before running it, and waits
# while plymouthd still holds that VT. On real SeaBIOS boots that wait came before this script
# ever started: autologin, and the desktop, were about two minutes late (#820). `deactivate`
# alone is not enough either: plymouthd keeps tty1 open until it exits. So plymouth quits here,
# before getty asks for tty1.
#
# Every call to plymouth is bounded (PLY_WAIT seconds). A plymouthd that stops answering is
# killed, because a frame of black is better than no desktop. The unit bounds the whole step too
# (TimeoutStartSec).
#
# Nothing here asks for or reads anything typed: the disk's password prompt is the theme's, and is
# over before this runs. With plymouth not running (`plymouth.enable=0`, the boot that shows every
# message, no plymouth in the image) it does nothing.
set -u

PLY_WAIT="${YANTRIK_SPLASH_PLY_WAIT:-5}"            # seconds any one plymouth call may take

command -v plymouth >/dev/null 2>&1 || exit 0

ply() {
    timeout -k 1 "$PLY_WAIT" plymouth "$@" 2>/dev/null
}

case "${1:-}" in
    release) ;;
    *)
        echo "usage: splash release" >&2
        exit 2
        ;;
esac

ply --ping
case $? in
    0) ;;
    124 | 137) ;;   # running, and not answering: below, it is killed if quit does not answer
    *) exit 0 ;;    # not running
esac

ply quit --retain-splash && exit 0
pkill -x plymouthd 2>/dev/null
sleep 1
pkill -KILL -x plymouthd 2>/dev/null
exit 0
