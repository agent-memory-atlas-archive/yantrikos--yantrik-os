#!/usr/bin/env python3
"""The problem-report intake: the one place a Yantrik OS machine can send a crash record, and the
only place the project's GitHub token lives.

    POST /v1/report   {"record": {...}, "note": "..."}   ->  {"issue_url", "issue_number", "count", "created"}
    GET  /v1/health                                     ->  {"ok": true}

Why a service and not a token in the image: a token in a public ISO is everyone's token. Why not
a prefilled GitHub URL: that needs an account and puts a name on the report. This service takes
an anonymous record, files or updates ONE GitHub issue per crash signature, and answers with
where it landed. It records nothing about the sender: the address is used for the rate limiter,
kept in memory for an hour, and never written anywhere. See design/problem-reports-2026-09-23.md.

Runs as the `yantrik-report` systemd unit, bound to 127.0.0.1:8471 behind nginx at
report.yantrikos.com. Configuration is the environment:

    GITHUB_TOKEN   the token (issues: write on yantrikos/yantrik-os); /etc/yantrik-report.env, root-only
    REPORT_REPO    default yantrikos/yantrik-os
    REPORT_STATE   default /var/lib/yantrik-report/issues.json
    REPORT_BIND    default 127.0.0.1:8471

Standard library only, like yantrik-publish beside it, so it runs on the VPS as installed.
"""
import hashlib
import json
import os
import re
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

REPO = os.environ.get("REPORT_REPO", "yantrikos/yantrik-os")
STATE = os.environ.get("REPORT_STATE", "/var/lib/yantrik-report/issues.json")
BIND = os.environ.get("REPORT_BIND", "127.0.0.1:8471")
TOKEN = os.environ.get("GITHUB_TOKEN", "")

MAX_BODY = 64 * 1024          # a record with forty log lines and a backtrace fits in a fraction
PER_HOUR = 10                 # reports one address may send in an hour
KINDS = {"panic", "crash", "failure"}
# The only fields a record may carry. Anything else is dropped before it reaches an issue, so a
# client that grew a field by mistake cannot leak through here.
FIELDS = {"kind", "program", "version", "git", "message", "location", "backtrace", "log_tail", "machine", "when"}
MACHINE_FIELDS = {"cores", "ram_gb", "gpu", "virtualised", "kernel"}

_lock = threading.Lock()
_recent = {}   # address -> [unix seconds of reports in the last hour]; memory only, never written


def log(msg):
    sys.stderr.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + msg + "\n")
    sys.stderr.flush()


def load_state():
    try:
        with open(STATE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


def rate_limited(address):
    now = time.time()
    with _lock:
        stamps = [t for t in _recent.get(address, []) if now - t < 3600]
        if len(stamps) >= PER_HOUR:
            _recent[address] = stamps
            return True
        stamps.append(now)
        _recent[address] = stamps
        # Forget addresses with nothing in the last hour, so the table holds only what the
        # limiter needs right now.
        for a in [a for a, s in _recent.items() if not any(now - t < 3600 for t in s)]:
            del _recent[a]
    return False


def clean(record):
    """The record with only the fields a record may have, and a sentence for anything wrong."""
    if not isinstance(record, dict):
        return None, "record must be an object"
    out = {k: v for k, v in record.items() if k in FIELDS}
    for key in ("kind", "program", "version", "message"):
        if not isinstance(out.get(key), str) or not out[key].strip():
            return None, "record.%s must be a non-empty string" % key
    if out["kind"] not in KINDS:
        return None, "record.kind must be one of panic, crash, failure"
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", out["program"]):
        return None, "record.program must be a program name"
    for key in ("location", "backtrace", "git"):
        if key in out and not isinstance(out[key], str):
            return None, "record.%s must be a string" % key
    if "log_tail" in out:
        if not isinstance(out["log_tail"], list) or not all(isinstance(l, str) for l in out["log_tail"]):
            return None, "record.log_tail must be a list of strings"
        out["log_tail"] = out["log_tail"][-40:]
    machine = out.get("machine")
    out["machine"] = {k: v for k, v in machine.items() if k in MACHINE_FIELDS} if isinstance(machine, dict) else {}
    if not isinstance(out.get("when"), int):
        out["when"] = 0
    return out, None


def fingerprint(record):
    """Same program, same kind, same place: one issue. The place is the panic location when there
    is one, else the first line of the message with numbers blanked, so `exit status: 139 after
    4123 ms` and `... after 9870 ms` are the same crash."""
    place = record.get("location") or re.sub(r"\d+", "N", record["message"].splitlines()[0][:120])
    raw = "|".join([record["program"], record["kind"], place])
    return hashlib.sha256(raw.encode("utf-8")).hexdigest()[:12]


def title_of(record):
    verb = {"panic": "panicked", "crash": "crashed", "failure": "failed"}[record["kind"]]
    where = record.get("location")
    where = " at " + where.rsplit("/", 1)[-1] if where else ""
    return ("%s %s%s on %s" % (record["program"], verb, where, record["version"]))[:100]


def body_of(record, note, count):
    lines = ["_Reported from a Yantrik OS machine through report.yantrikos.com. The record carries no "
             "name, hostname or address; this is the file as the machine held it._", ""]
    if note.strip():
        lines += ["**What the person was doing:**", "", "> " + note.strip().replace("\n", "\n> "), ""]
    lines += ["```json", json.dumps(record, indent=2, sort_keys=True), "```"]
    if count > 1:
        lines += ["", "_Report %d of the same signature._" % count]
    return "\n".join(lines)


def github(method, path, payload):
    req = urllib.request.Request(
        "https://api.github.com" + path,
        data=json.dumps(payload).encode("utf-8"),
        method=method,
        headers={
            "Authorization": "Bearer " + TOKEN,
            "Accept": "application/vnd.github+json",
            "Content-Type": "application/json",
            "User-Agent": "yantrik-report",
        },
    )
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.load(resp)


def file_report(record, note):
    """Create or update the issue for this record's signature. Returns the answer for the client."""
    fp = fingerprint(record)
    with _lock:
        state = load_state()
        known = state.get(fp)
        if known:
            count = known["count"] + 1
            github("POST", "/repos/%s/issues/%d/comments" % (REPO, known["number"]),
                   {"body": body_of(record, note, count)})
            title = re.sub(r" \(×\d+\)$", "", known["title"]) + " (×%d)" % count
            github("PATCH", "/repos/%s/issues/%d" % (REPO, known["number"]), {"title": title})
            known.update({"count": count, "title": title, "last": int(time.time())})
            state[fp] = known
            save_state(state)
            return {"issue_url": known["url"], "issue_number": known["number"], "count": count, "created": False}
        title = title_of(record)
        issue = github("POST", "/repos/%s/issues" % REPO, {
            "title": title,
            "body": body_of(record, note, 1),
            "labels": ["problem-report", record["kind"]],
        })
        state[fp] = {"number": issue["number"], "url": issue["html_url"], "title": title,
                     "count": 1, "first": int(time.time()), "last": int(time.time())}
        save_state(state)
        return {"issue_url": issue["html_url"], "issue_number": issue["number"], "count": 1, "created": True}


class Handler(BaseHTTPRequestHandler):
    server_version = "yantrik-report/1"

    def log_message(self, fmt, *args):  # the default logs the address; we log our own lines
        pass

    def answer(self, code, obj):
        data = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/v1/health":
            return self.answer(200, {"ok": True, "repo": REPO})
        self.answer(404, {"error": "no such path"})

    def do_POST(self):
        if self.path != "/v1/report":
            return self.answer(404, {"error": "no such path"})
        # nginx passes the client address in X-Forwarded-For; only the limiter sees it.
        address = (self.headers.get("X-Forwarded-For", "") or self.client_address[0]).split(",")[0].strip()
        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0 or length > MAX_BODY:
            return self.answer(413, {"error": "a report is at most %d bytes" % MAX_BODY})
        if rate_limited(address):
            return self.answer(429, {"error": "at most %d reports an hour from one place" % PER_HOUR})
        try:
            payload = json.loads(self.rfile.read(length).decode("utf-8"))
        except ValueError:
            return self.answer(400, {"error": "the body is not JSON"})
        record, why = clean(payload.get("record") if isinstance(payload, dict) else None)
        if why:
            return self.answer(400, {"error": why})
        note = payload.get("note") if isinstance(payload.get("note"), str) else ""
        note = note[:2000]
        if not TOKEN:
            return self.answer(503, {"error": "the intake has no GitHub token configured"})
        try:
            answer = file_report(record, note)
        except urllib.error.HTTPError as e:
            log("github %s %s: %s" % (e.code, e.reason, e.read()[:200].decode("utf-8", "replace")))
            return self.answer(502, {"error": "GitHub answered %d" % e.code})
        except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
            log("github failed: %r" % (e,))
            return self.answer(502, {"error": "could not reach GitHub"})
        log("report %s %s -> #%d (%s, count %d)" % (
            record["kind"], record["program"], answer["issue_number"],
            "new" if answer["created"] else "joined", answer["count"]))
        self.answer(200, answer)


def main():
    host, port = BIND.rsplit(":", 1)
    if not TOKEN:
        log("warning: GITHUB_TOKEN is not set; reports will be refused with 503")
    server = ThreadingHTTPServer((host, int(port)), Handler)
    log("yantrik-report listening on %s for %s" % (BIND, REPO))
    server.serve_forever()


if __name__ == "__main__":
    main()
