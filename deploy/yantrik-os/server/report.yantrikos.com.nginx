# report.yantrikos.com — the problem-report intake, proxied to the yantrik-report service.
#
#   sudo install -m 644 report.yantrikos.com.nginx /etc/nginx/sites-available/report.yantrikos.com
#   sudo ln -s ../sites-available/report.yantrikos.com /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d report.yantrikos.com
#   sudo nginx -t && sudo systemctl reload nginx
#
# The access log is off on purpose: the service keeps the client address in memory for its
# rate limiter and nowhere else, and an nginx access log would be a second, durable record of
# who reported what, which the design promises does not exist.
server {
    listen 80;
    listen [::]:80;
    server_name report.yantrikos.com;

    access_log off;
    client_max_body_size 128k;

    location /v1/ {
        proxy_pass http://127.0.0.1:8471;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
