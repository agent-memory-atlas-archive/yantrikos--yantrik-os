[Unit]
Description=Pi, attached to the Yantrik OS desktop as a mind
Documentation=file:///opt/yantrik/share/harnesses/pi/README.md
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/yantrik/share/harnesses/pi/yantrik_pi.py
Restart=on-failure
RestartSec=5
# The person's desktop settings, memory grants among them (#447), are the desktop's to write,
# not a mind's: this harness and everything it starts see ~/.config/yantrik read-only. It only
# ever reads its own json and env file there. A second line, not a wall: the desktop's own tools
# already refuse an agent's write there (#443), and a process running as the person can still
# ask the user manager to run something outside this unit. In a user unit this implies
# PrivateUsers=, which needs unprivileged user namespaces (on by default on Debian); the `-`
# lets the unit start where the folder does not exist yet.
ReadOnlyPaths=-%h/.config/yantrik
# A user service does not inherit a login shell's PATH, and `pi` and `node` are usually
# installed per-user (~/.npm-global/bin, ~/.local/node/bin). Either set them here:
#   Environment=PATH=%h/.npm-global/bin:%h/.local/node/bin:/usr/bin:/bin
# or put the same string in `path` in ~/.config/yantrik/pi.json, which this harness prepends.
# Pi's provider keys are Pi's own business and live in ~/.pi/agent. Nothing in this unit and
# nothing in the image holds one.

[Install]
WantedBy=default.target
